Dialogue: 0,0:00:00.00,0:00:01.53,Cap,,0,0,0,,SIXTEENTH OF SEPTEMBER.
Dialogue: 0,0:00:01.53,0:00:02.64,Cap,,0,0,0,,OLD TRAFFORD.
Dialogue: 0,0:00:02.64,0:00:03.62,Cap,,0,0,0,,TWELVE MINUTES IN,
Dialogue: 0,0:00:03.62,0:00:05.22,Cap,,0,0,0,,MANCHESTER UNITED ARE TWO-NIL
Dialogue: 0,0:00:05.22,0:00:06.61,Cap,,0,0,0,,UP AGAINST BRIGHTON.
Dialogue: 0,0:00:06.61,0:00:07.86,Cap,,0,0,0,,THEN IT ALL FALLS
Dialogue: 0,0:00:07.86,0:00:08.77,Cap,,0,0,0,,APART.
Dialogue: 0,0:00:08.77,0:00:10.30,Cap,,0,0,0,,BRIGHTON SCORE THREE.
Dialogue: 0,0:00:10.30,0:00:11.37,Cap,,0,0,0,,UNITED ARE OUT OF
Dialogue: 0,0:00:11.37,0:00:12.52,Cap,,0,0,0,,THE CARABAO CUP.
Dialogue: 0,0:00:12.52,0:00:13.22,Cap,,0,0,0,,AND FOR THE FIRST
Dialogue: 0,0:00:13.22,0:00:14.75,Cap,,0,0,0,,TIME IN FIFTY YEARS,
Dialogue: 0,0:00:14.75,0:00:15.65,Cap,,0,0,0,,UNITED HAVE LOST A
Dialogue: 0,0:00:15.65,0:00:16.87,Cap,,0,0,0,,HOME GAME AFTER LEADING
Dialogue: 0,0:00:16.87,0:00:18.37,Cap,,0,0,0,,BY TWO GOALS.
Dialogue: 0,0:00:18.37,0:00:19.48,Cap,,0,0,0,,MICHAEL CARRICK WALKS INTO
Dialogue: 0,0:00:19.48,0:00:20.52,Cap,,0,0,0,,HIS PRESS CONFERENCE,
Dialogue: 0,0:00:20.52,0:00:21.46,Cap,,0,0,0,,AND HE DOES NOT
Dialogue: 0,0:00:21.46,0:00:22.09,Cap,,0,0,0,,HIDE.
Dialogue: 0,0:00:22.26,0:00:23.94,Cap,,0,0,0,,SO WE HAD THE
Dialogue: 0,0:00:23.94,0:00:24.80,Cap,,0,0,0,,GAME EXACTLY WHERE WE
Dialogue: 0,0:00:24.80,0:00:25.86,Cap,,0,0,0,,WANTED IT AND LET
Dialogue: 0,0:00:25.86,0:00:26.50,Cap,,0,0,0,,IT GET AWAY FROM
Dialogue: 0,0:00:26.50,0:00:27.84,Cap,,0,0,0,,US IN A BIG
Dialogue: 0,0:00:27.84,0:00:28.06,Cap,,0,0,0,,WAY.
Dialogue: 0,0:00:28.06,0:00:28.59,Cap,,0,0,0,,SO,
Dialogue: 0,0:00:28.76,0:00:29.80,Cap,,0,0,0,,EIGHT MONTHS AGO,
Dialogue: 0,0:00:29.80,0:00:30.49,Cap,,0,0,0,,THIS MAN WAS THE
Dialogue: 0,0:00:30.49,0:00:31.16,Cap,,0,0,0,,ANSWER.
Dialogue: 0,0:00:31.40,0:00:31.92,Cap,,0,0,0,,NOW,
Dialogue: 0,0:00:31.92,0:00:33.03,Cap,,0,0,0,,AFTER JUST FIVE LEAGUE
Dialogue: 0,0:00:33.03,0:00:33.56,Cap,,0,0,0,,GAMES,
Dialogue: 0,0:00:33.56,0:00:34.46,Cap,,0,0,0,,PEOPLE ARE ASKING IF
Dialogue: 0,0:00:34.46,0:00:35.96,Cap,,0,0,0,,HE IS THE PROBLEM.
Dialogue: 0,0:00:35.99,0:00:36.96,Cap,,0,0,0,,SO HOW DID CARRICK'S
Dialogue: 0,0:00:36.96,0:00:37.87,Cap,,0,0,0,,UNITED GO FROM THE
Dialogue: 0,0:00:37.87,0:00:38.49,Cap,,0,0,0,,BEST TEAM IN THE
Dialogue: 0,0:00:38.49,0:00:39.19,Cap,,0,0,0,,COUNTRY,
Dialogue: 0,0:00:39.19,0:00:40.09,Cap,,0,0,0,,TO THIS,
Dialogue: 0,0:00:40.09,0:00:41.18,Cap,,0,0,0,,SO FAST?
Dialogue: 0,0:00:41.22,0:00:42.51,Cap,,0,0,0,,GO BACK TO JANUARY.
Dialogue: 0,0:00:42.68,0:00:43.93,Cap,,0,0,0,,RUBEN AMORIM HAS JUST
Dialogue: 0,0:00:43.93,0:00:44.90,Cap,,0,0,0,,BEEN SACKED.
Dialogue: 0,0:00:44.90,0:00:45.74,Cap,,0,0,0,,THE CLUB IS IN
Dialogue: 0,0:00:45.74,0:00:46.78,Cap,,0,0,0,,CHAOS.
Dialogue: 0,0:00:46.78,0:00:47.83,Cap,,0,0,0,,UNITED TURN TO A
Dialogue: 0,0:00:47.83,0:00:48.63,Cap,,0,0,0,,FORMER PLAYER,
Dialogue: 0,0:00:48.63,0:00:50.05,Cap,,0,0,0,,WITH ONE JOB: STEADY
Dialogue: 0,0:00:50.05,0:00:51.03,Cap,,0,0,0,,THE SHIP UNTIL THE
Dialogue: 0,0:00:51.03,0:00:51.83,Cap,,0,0,0,,SUMMER.
Dialogue: 0,0:00:51.83,0:00:53.46,Cap,,0,0,0,,NOT EVERYONE WAS CONVINCED.
Dialogue: 0,0:00:53.46,0:00:54.71,Cap,,0,0,0,,ROY KEANE CERTAINLY WAS
Dialogue: 0,0:00:54.71,0:00:55.45,Cap,,0,0,0,,NOT.
Dialogue: 0,0:00:55.60,0:00:56.87,Cap,,0,0,0,,MICHAEL CARRICK,
Dialogue: 0,0:00:57.62,0:00:58.48,Cap,,0,0,0,,WHATEVER HIS REMIT WAS
Dialogue: 0,0:00:58.48,0:00:59.00,Cap,,0,0,0,,AT MIDDLESBROUGH,
Dialogue: 0,0:00:59.00,0:00:59.56,Cap,,0,0,0,,I'M PRETTY SURE IT
Dialogue: 0,0:00:59.56,0:01:00.32,Cap,,0,0,0,,WAS TO PROBABLY GET
Dialogue: 0,0:01:00.32,0:01:00.91,Cap,,0,0,0,,PROMOTED,
Dialogue: 0,0:01:00.92,0:01:02.03,Cap,,0,0,0,,HE DIDN'T DO THAT,
Dialogue: 0,0:01:02.36,0:01:02.98,Cap,,0,0,0,,SO YOU CAN SEE
Dialogue: 0,0:01:02.98,0:01:04.05,Cap,,0,0,0,,HE FAILED THERE,
Dialogue: 0,0:01:04.50,0:01:06.03,Cap,,0,0,0,,WHAT HAPPENED NEXT SURPRISED
Dialogue: 0,0:01:06.03,0:01:07.53,Cap,,0,0,0,,ALMOST EVERYONE.
Dialogue: 0,0:01:07.56,0:01:09.20,Cap,,0,0,0,,SEVENTEEN LEAGUE GAMES.
Dialogue: 0,0:01:09.30,0:01:10.28,Cap,,0,0,0,,TWELVE WINS.
Dialogue: 0,0:01:10.28,0:01:11.29,Cap,,0,0,0,,THREE DRAWS.
Dialogue: 0,0:01:11.39,0:01:12.92,Cap,,0,0,0,,JUST TWO DEFEATS.
Dialogue: 0,0:01:12.92,0:01:14.14,Cap,,0,0,0,,WINS OVER CITY,
Dialogue: 0,0:01:14.14,0:01:14.73,Cap,,0,0,0,,ARSENAL,
Dialogue: 0,0:01:14.73,0:01:16.30,Cap,,0,0,0,,LIVERPOOL AND CHELSEA.
Dialogue: 0,0:01:16.61,0:01:17.65,Cap,,0,0,0,,OVER THAT STRETCH,
Dialogue: 0,0:01:17.65,0:01:18.48,Cap,,0,0,0,,NOBODY IN THE LEAGUE
Dialogue: 0,0:01:18.48,0:01:19.57,Cap,,0,0,0,,TOOK MORE POINTS.
Dialogue: 0,0:01:19.67,0:01:21.09,Cap,,0,0,0,,UNITED FINISHED THIRD,
Dialogue: 0,0:01:21.09,0:01:21.75,Cap,,0,0,0,,AND THEY WERE BACK
Dialogue: 0,0:01:21.75,0:01:23.05,Cap,,0,0,0,,IN THE CHAMPIONS LEAGUE.
Dialogue: 0,0:01:23.15,0:01:23.75,Cap,,0,0,0,,BUT WHAT MICHAEL CARRICK
Dialogue: 0,0:01:23.75,0:01:24.37,Cap,,0,0,0,,WAS ABLE TO DO
Dialogue: 0,0:01:24.37,0:01:25.67,Cap,,0,0,0,,A FEW WEEKS LATER
Dialogue: 0,0:01:25.67,0:01:26.69,Cap,,0,0,0,,WAS REALLY JUST CALM
Dialogue: 0,0:01:26.69,0:01:28.27,Cap,,0,0,0,,ALL THE NOISE INSIDE
Dialogue: 0,0:01:28.27,0:01:29.94,Cap,,0,0,0,,AND OUTSIDE THE CLUB.
Dialogue: 0,0:01:30.39,0:01:31.68,Cap,,0,0,0,,SO UNITED GAVE HIM
Dialogue: 0,0:01:31.68,0:01:32.38,Cap,,0,0,0,,THE JOB.
Dialogue: 0,0:01:32.48,0:01:33.87,Cap,,0,0,0,,A TWO-YEAR CONTRACT,
Dialogue: 0,0:01:33.87,0:01:35.33,Cap,,0,0,0,,UNTIL TWENTY TWENTY-EIGHT.
Dialogue: 0,0:01:35.33,0:01:36.23,Cap,,0,0,0,,AND HERE IS WHERE
Dialogue: 0,0:01:36.23,0:01:37.76,Cap,,0,0,0,,THE WARNING SIGNS START.
Dialogue: 0,0:01:37.76,0:01:38.46,Cap,,0,0,0,,BECAUSE WHEN YOU LOOK
Dialogue: 0,0:01:38.46,0:01:39.89,Cap,,0,0,0,,CLOSELY AT THAT RUN,
Dialogue: 0,0:01:39.89,0:01:40.44,Cap,,0,0,0,,A LOT OF IT
Dialogue: 0,0:01:40.44,0:01:41.38,Cap,,0,0,0,,WAS BUILT ON FINDING
Dialogue: 0,0:01:41.38,0:01:42.49,Cap,,0,0,0,,A WAY TO WIN,
Dialogue: 0,0:01:42.49,0:01:44.44,Cap,,0,0,0,,NOT ON DOMINATING GAMES.
Dialogue: 0,0:01:44.44,0:01:45.24,Cap,,0,0,0,,CARRICK HAS SAID SO
Dialogue: 0,0:01:45.24,0:01:46.08,Cap,,0,0,0,,HIMSELF.
Dialogue: 0,0:01:46.24,0:01:48.12,Cap,,0,0,0,,WE WON LAST YEAR
Dialogue: 0,0:01:48.12,0:01:50.22,Cap,,0,0,0,,BY SOMETIMES NOT PLAYING
Dialogue: 0,0:01:50.22,0:01:51.24,Cap,,0,0,0,,PARTICULARLY WELL.
Dialogue: 0,0:01:51.24,0:01:51.66,Cap,,0,0,0,,WE FOUND A WAY
Dialogue: 0,0:01:51.66,0:01:52.29,Cap,,0,0,0,,TO WIN.
Dialogue: 0,0:01:52.74,0:01:53.97,Cap,,0,0,0,,THEN CAME THE SUMMER.
Dialogue: 0,0:01:54.21,0:01:55.43,Cap,,0,0,0,,CASEMIRO LEFT.
Dialogue: 0,0:01:55.60,0:01:56.64,Cap,,0,0,0,,THE MIDFIELD WAS MEANT
Dialogue: 0,0:01:56.64,0:01:58.00,Cap,,0,0,0,,TO BE THE PRIORITY.
Dialogue: 0,0:01:58.03,0:01:58.66,Cap,,0,0,0,,BUT FOR A CLUB
Dialogue: 0,0:01:58.66,0:01:59.28,Cap,,0,0,0,,ABOUT TO PLAY IN
Dialogue: 0,0:01:59.28,0:02:00.36,Cap,,0,0,0,,THE CHAMPIONS LEAGUE,
Dialogue: 0,0:02:00.36,0:02:02.14,Cap,,0,0,0,,THE WINDOW WAS CAUTIOUS.
Dialogue: 0,0:02:02.14,0:02:03.04,Cap,,0,0,0,,THE SQUAD THAT STARTED
Dialogue: 0,0:02:03.04,0:02:04.08,Cap,,0,0,0,,THIS SEASON LOOKED A
Dialogue: 0,0:02:04.08,0:02:04.95,Cap,,0,0,0,,LOT LIKE THE SQUAD
Dialogue: 0,0:02:04.95,0:02:05.82,Cap,,0,0,0,,THAT ENDED THE LAST
Dialogue: 0,0:02:05.82,0:02:06.28,Cap,,0,0,0,,ONE.
Dialogue: 0,0:02:06.38,0:02:07.35,Cap,,0,0,0,,ONLY NOW,
Dialogue: 0,0:02:07.35,0:02:08.33,Cap,,0,0,0,,EVERY OPPONENT HAD A
Dialogue: 0,0:02:08.33,0:02:09.55,Cap,,0,0,0,,SUMMER TO STUDY IT.
Dialogue: 0,0:02:09.60,0:02:10.78,Cap,,0,0,0,,OPENING DAY.
Dialogue: 0,0:02:10.78,0:02:12.49,Cap,,0,0,0,,NEWLY PROMOTED HULL CITY.
Dialogue: 0,0:02:12.66,0:02:14.23,Cap,,0,0,0,,UNITED LOSE TWO-NIL.
Dialogue: 0,0:02:14.47,0:02:15.30,Cap,,0,0,0,,A WEEK LATER,
Dialogue: 0,0:02:15.30,0:02:16.55,Cap,,0,0,0,,BRUNO FERNANDES SCORES A
Dialogue: 0,0:02:16.55,0:02:17.74,Cap,,0,0,0,,HAT-TRICK IN A FIVE-TWO
Dialogue: 0,0:02:17.74,0:02:19.06,Cap,,0,0,0,,WIN OVER IPSWICH,
Dialogue: 0,0:02:19.06,0:02:19.58,Cap,,0,0,0,,AND IT LOOKS LIKE
Dialogue: 0,0:02:19.58,0:02:20.28,Cap,,0,0,0,,A BLIP.
Dialogue: 0,0:02:20.52,0:02:21.49,Cap,,0,0,0,,IT WASN'T.
Dialogue: 0,0:02:21.49,0:02:22.54,Cap,,0,0,0,,A TWO-ALL DRAW WITH
Dialogue: 0,0:02:22.54,0:02:23.37,Cap,,0,0,0,,EVERTON.
Dialogue: 0,0:02:23.37,0:02:24.48,Cap,,0,0,0,,THEN THE DERBY,
Dialogue: 0,0:02:24.48,0:02:25.50,Cap,,0,0,0,,AT OLD TRAFFORD.
Dialogue: 0,0:02:25.74,0:02:26.54,Cap,,0,0,0,,CITY GO DOWN TO
Dialogue: 0,0:02:26.54,0:02:27.16,Cap,,0,0,0,,TEN MEN,
Dialogue: 0,0:02:27.16,0:02:28.73,Cap,,0,0,0,,AND UNITED STILL LOSE,
Dialogue: 0,0:02:28.73,0:02:29.32,Cap,,0,0,0,,ONE-NIL,
Dialogue: 0,0:02:29.32,0:02:30.44,Cap,,0,0,0,,TO A HAALAND GOAL.
Dialogue: 0,0:02:30.67,0:02:31.65,Cap,,0,0,0,,THREE DAYS LATER,
Dialogue: 0,0:02:31.65,0:02:32.39,Cap,,0,0,0,,BRIGHTON.
Dialogue: 0,0:02:32.41,0:02:33.39,Cap,,0,0,0,,AND THEN A LATE
Dialogue: 0,0:02:33.39,0:02:34.50,Cap,,0,0,0,,EQUALISER TO SCRAPE A
Dialogue: 0,0:02:34.50,0:02:35.72,Cap,,0,0,0,,DRAW AT FULHAM.
Dialogue: 0,0:02:35.76,0:02:36.66,Cap,,0,0,0,,HERE IS THE NUMBER
Dialogue: 0,0:02:36.66,0:02:37.89,Cap,,0,0,0,,THAT TELLS THE STORY.
Dialogue: 0,0:02:38.12,0:02:39.45,Cap,,0,0,0,,IN SEVENTEEN LEAGUE GAMES
Dialogue: 0,0:02:39.45,0:02:40.63,Cap,,0,0,0,,AS INTERIM MANAGER,
Dialogue: 0,0:02:40.63,0:02:42.23,Cap,,0,0,0,,CARRICK LOST TWICE.
Dialogue: 0,0:02:42.23,0:02:42.99,Cap,,0,0,0,,THIS SEASON,
Dialogue: 0,0:02:42.99,0:02:44.25,Cap,,0,0,0,,IN ALL COMPETITIONS,
Dialogue: 0,0:02:44.25,0:02:45.71,Cap,,0,0,0,,UNITED HAVE ALREADY LOST
Dialogue: 0,0:02:45.71,0:02:46.92,Cap,,0,0,0,,THREE TIMES.
Dialogue: 0,0:02:46.92,0:02:47.90,Cap,,0,0,0,,ONE WIN IN FIVE
Dialogue: 0,0:02:47.90,0:02:48.77,Cap,,0,0,0,,IN THE LEAGUE.
Dialogue: 0,0:02:48.77,0:02:50.20,Cap,,0,0,0,,TWELFTH IN THE TABLE.
Dialogue: 0,0:02:50.36,0:02:51.58,Cap,,0,0,0,,IT'S A NEW SEASON,
Dialogue: 0,0:02:51.58,0:02:52.54,Cap,,0,0,0,,IT'S A FRESH SEASON
Dialogue: 0,0:02:52.54,0:02:53.80,Cap,,0,0,0,,AND THE POINTS TALLY
Dialogue: 0,0:02:53.80,0:02:55.26,Cap,,0,0,0,,RIGHT NOW IS NOT
Dialogue: 0,0:02:55.26,0:02:55.78,Cap,,0,0,0,,WHAT WE WANT IT
Dialogue: 0,0:02:55.78,0:02:56.33,Cap,,0,0,0,,TO BE.
Dialogue: 0,0:02:56.40,0:02:57.74,Cap,,0,0,0,,SO I'M NOT HIDING
Dialogue: 0,0:02:57.74,0:02:58.26,Cap,,0,0,0,,FROM THAT,
Dialogue: 0,0:02:58.26,0:02:58.57,Cap,,0,0,0,,BUT
Dialogue: 0,0:02:58.86,0:03:00.60,Cap,,0,0,0,,SO WHAT HAS CHANGED?
Dialogue: 0,0:03:00.60,0:03:01.47,Cap,,0,0,0,,LAST SEASON,
Dialogue: 0,0:03:01.47,0:03:02.51,Cap,,0,0,0,,CARRICK'S UNITED WERE THE
Dialogue: 0,0:03:02.51,0:03:03.73,Cap,,0,0,0,,TEAM NOBODY HAD PLANNED
Dialogue: 0,0:03:03.73,0:03:04.43,Cap,,0,0,0,,FOR.
Dialogue: 0,0:03:04.43,0:03:05.33,Cap,,0,0,0,,THEY SAT DEEP,
Dialogue: 0,0:03:05.33,0:03:06.48,Cap,,0,0,0,,THEY STAYED COMPACT,
Dialogue: 0,0:03:06.48,0:03:07.31,Cap,,0,0,0,,AND THEY HURT TEAMS
Dialogue: 0,0:03:07.31,0:03:08.43,Cap,,0,0,0,,ON THE BREAK.
Dialogue: 0,0:03:08.43,0:03:09.16,Cap,,0,0,0,,THIS SEASON,
Dialogue: 0,0:03:09.16,0:03:10.69,Cap,,0,0,0,,OPPONENTS KNOW EXACTLY WHAT
Dialogue: 0,0:03:10.69,0:03:11.66,Cap,,0,0,0,,IS COMING.
Dialogue: 0,0:03:11.66,0:03:12.57,Cap,,0,0,0,,TEAMS DROP OFF AND
Dialogue: 0,0:03:12.57,0:03:13.54,Cap,,0,0,0,,MAKE UNITED HAVE THE
Dialogue: 0,0:03:13.54,0:03:14.10,Cap,,0,0,0,,BALL,
Dialogue: 0,0:03:14.10,0:03:15.31,Cap,,0,0,0,,AND UNITED HAVE STRUGGLED
Dialogue: 0,0:03:15.31,0:03:16.67,Cap,,0,0,0,,TO BREAK THEM DOWN.
Dialogue: 0,0:03:16.67,0:03:17.47,Cap,,0,0,0,,AGAINST BRIGHTON,
Dialogue: 0,0:03:17.47,0:03:18.48,Cap,,0,0,0,,AFTER GOING TWO UP
Dialogue: 0,0:03:18.48,0:03:19.59,Cap,,0,0,0,,INSIDE TEN MINUTES,
Dialogue: 0,0:03:19.59,0:03:20.39,Cap,,0,0,0,,THEY DID NOT HAVE
Dialogue: 0,0:03:20.39,0:03:21.40,Cap,,0,0,0,,ANOTHER SHOT ON TARGET
Dialogue: 0,0:03:21.40,0:03:22.65,Cap,,0,0,0,,UNTIL THE SEVENTY-SIXTH
Dialogue: 0,0:03:22.65,0:03:23.32,Cap,,0,0,0,,MINUTE.
Dialogue: 0,0:03:23.36,0:03:24.27,Cap,,0,0,0,,AND THE CROWD HAS
Dialogue: 0,0:03:24.27,0:03:25.17,Cap,,0,0,0,,NOTICED.
Dialogue: 0,0:03:25.17,0:03:26.08,Cap,,0,0,0,,AT FULL TIME AGAINST
Dialogue: 0,0:03:26.08,0:03:26.70,Cap,,0,0,0,,BRIGHTON,
Dialogue: 0,0:03:26.70,0:03:27.75,Cap,,0,0,0,,THERE WERE BOOS AROUND
Dialogue: 0,0:03:27.75,0:03:28.79,Cap,,0,0,0,,OLD TRAFFORD.
Dialogue: 0,0:03:28.79,0:03:29.76,Cap,,0,0,0,,CARRICK WAS ASKED IF
Dialogue: 0,0:03:29.76,0:03:30.92,Cap,,0,0,0,,HE COULD FEEL IT.
Dialogue: 0,0:03:31.07,0:03:31.79,Cap,,0,0,0,,WE HAVE TO ACCEPT
Dialogue: 0,0:03:31.79,0:03:31.97,Cap,,0,0,0,,IT,
Dialogue: 0,0:03:31.97,0:03:33.20,Cap,,0,0,0,,I TOTALLY ACCEPT IT.
Dialogue: 0,0:03:33.81,0:03:34.51,Cap,,0,0,0,,IT'S ON ME,
Dialogue: 0,0:03:34.51,0:03:35.11,Cap,,0,0,0,,ULTIMATELY,
Dialogue: 0,0:03:35.11,0:03:35.54,Cap,,0,0,0,,YOU KNOW,
Dialogue: 0,0:03:36.35,0:03:37.25,Cap,,0,0,0,,AS A TEAM,
Dialogue: 0,0:03:37.25,0:03:37.81,Cap,,0,0,0,,WHAT WE LOOK LIKE,
Dialogue: 0,0:03:37.81,0:03:38.54,Cap,,0,0,0,,HOW WE PLAY,
Dialogue: 0,0:03:38.89,0:03:40.16,Cap,,0,0,0,,WHAT RESULTS YOU GET.
Dialogue: 0,0:03:40.61,0:03:41.31,Cap,,0,0,0,,THIS IS THE PART
Dialogue: 0,0:03:41.31,0:03:42.63,Cap,,0,0,0,,UNITED FANS KNOW TOO
Dialogue: 0,0:03:42.63,0:03:43.23,Cap,,0,0,0,,WELL.
Dialogue: 0,0:03:43.40,0:03:44.65,Cap,,0,0,0,,A MANAGER ARRIVES.
Dialogue: 0,0:03:44.65,0:03:46.22,Cap,,0,0,0,,RESULTS COME FAST.
Dialogue: 0,0:03:46.25,0:03:47.33,Cap,,0,0,0,,HE GETS THE JOB.
Dialogue: 0,0:03:47.57,0:03:48.61,Cap,,0,0,0,,AND THEN THE CLUB
Dialogue: 0,0:03:48.61,0:03:49.76,Cap,,0,0,0,,SLIDES BACK INTO THE
Dialogue: 0,0:03:49.76,0:03:50.98,Cap,,0,0,0,,SAME SPIRAL THAT SWALLOWED
Dialogue: 0,0:03:50.98,0:03:51.64,Cap,,0,0,0,,MOYES,
Dialogue: 0,0:03:51.64,0:03:52.34,Cap,,0,0,0,,VAN GAAL,
Dialogue: 0,0:03:52.34,0:03:53.07,Cap,,0,0,0,,MOURINHO,
Dialogue: 0,0:03:53.07,0:03:53.87,Cap,,0,0,0,,SOLSKJAER,
Dialogue: 0,0:03:53.87,0:03:55.47,Cap,,0,0,0,,TEN HAG AND AMORIM.
Dialogue: 0,0:03:55.78,0:03:57.10,Cap,,0,0,0,,KEANE'S REAL WARNING WAS
Dialogue: 0,0:03:57.10,0:03:58.42,Cap,,0,0,0,,NEVER ABOUT CARRICK.
Dialogue: 0,0:03:58.42,0:03:59.05,Cap,,0,0,0,,IT WAS ABOUT THE
Dialogue: 0,0:03:59.05,0:04:00.41,Cap,,0,0,0,,CLUB AROUND HIM.
Dialogue: 0,0:04:00.54,0:04:01.22,Cap,,0,0,0,,A WORLD -CLASS MANAGER
Dialogue: 0,0:04:01.22,0:04:02.66,Cap,,0,0,0,,WON'T COME HERE HE
Dialogue: 0,0:04:02.66,0:04:02.92,Cap,,0,0,0,,WON'T,
Dialogue: 0,0:04:02.92,0:04:03.20,Cap,,0,0,0,,HE WON'T,
Dialogue: 0,0:04:03.20,0:04:03.63,Cap,,0,0,0,,A
Dialogue: 0,0:04:03.90,0:04:04.31,Cap,,0,0,0,,NOW,
Dialogue: 0,0:04:04.31,0:04:05.15,Cap,,0,0,0,,TO BE FAIR,
Dialogue: 0,0:04:05.15,0:04:06.47,Cap,,0,0,0,,IT IS FIVE LEAGUE
Dialogue: 0,0:04:06.47,0:04:07.03,Cap,,0,0,0,,GAMES.
Dialogue: 0,0:04:07.03,0:04:07.97,Cap,,0,0,0,,UNITED ARE STILL IN
Dialogue: 0,0:04:07.97,0:04:08.94,Cap,,0,0,0,,THE CHAMPIONS LEAGUE,
Dialogue: 0,0:04:08.94,0:04:09.67,Cap,,0,0,0,,AND THEY STARTED THAT
Dialogue: 0,0:04:09.67,0:04:10.85,Cap,,0,0,0,,CAMPAIGN WITH A FOUR-NIL
Dialogue: 0,0:04:10.85,0:04:11.66,Cap,,0,0,0,,WIN.
Dialogue: 0,0:04:11.69,0:04:12.49,Cap,,0,0,0,,CARRICK HAS TURNED THIS
Dialogue: 0,0:04:12.49,0:04:14.05,Cap,,0,0,0,,SQUAD AROUND ONCE BEFORE,
Dialogue: 0,0:04:14.05,0:04:14.96,Cap,,0,0,0,,AND HE BELIEVES HE
Dialogue: 0,0:04:14.96,0:04:16.11,Cap,,0,0,0,,CAN DO IT AGAIN.
Dialogue: 0,0:04:16.28,0:04:17.38,Cap,,0,0,0,,BUT IT DOESN'T HAVE
Dialogue: 0,0:04:17.38,0:04:18.17,Cap,,0,0,0,,TO BE LIKE THAT.
Dialogue: 0,0:04:18.30,0:04:18.92,Cap,,0,0,0,,IF WE WIN FOOTBALL
Dialogue: 0,0:04:18.92,0:04:19.80,Cap,,0,0,0,,MATCHES AGAIN,
Dialogue: 0,0:04:19.80,0:04:21.02,Cap,,0,0,0,,IT CAN GO IN
Dialogue: 0,0:04:21.02,0:04:21.97,Cap,,0,0,0,,A DIFFERENT DIRECTION.
Dialogue: 0,0:04:22.42,0:04:23.39,Cap,,0,0,0,,AFTER THE INTERNATIONAL
Dialogue: 0,0:04:23.39,0:04:23.95,Cap,,0,0,0,,BREAK,
Dialogue: 0,0:04:23.95,0:04:24.85,Cap,,0,0,0,,TOTTENHAM COME TO OLD
Dialogue: 0,0:04:24.85,0:04:25.83,Cap,,0,0,0,,TRAFFORD.
Dialogue: 0,0:04:25.83,0:04:26.31,Cap,,0,0,0,,WIN,
Dialogue: 0,0:04:26.31,0:04:27.18,Cap,,0,0,0,,AND THIS BECOMES A
Dialogue: 0,0:04:27.18,0:04:28.19,Cap,,0,0,0,,BAD MONTH.
Dialogue: 0,0:04:28.19,0:04:28.78,Cap,,0,0,0,,LOSE,
Dialogue: 0,0:04:28.78,0:04:29.72,Cap,,0,0,0,,AND THE QUESTIONS GET
Dialogue: 0,0:04:29.72,0:04:30.83,Cap,,0,0,0,,A LOT LOUDER.
Dialogue: 0,0:04:30.83,0:04:31.74,Cap,,0,0,0,,EIGHT MONTHS AGO,
Dialogue: 0,0:04:31.74,0:04:33.37,Cap,,0,0,0,,MICHAEL CARRICK SAVED MANCHESTER
Dialogue: 0,0:04:33.37,0:04:34.52,Cap,,0,0,0,,UNITED'S SEASON.
Dialogue: 0,0:04:34.52,0:04:35.36,Cap,,0,0,0,,NOW HE HAS TO
Dialogue: 0,0:04:35.36,0:04:36.44,Cap,,0,0,0,,SAVE HIS OWN.
Dialogue: 0,0:04:36.49,0:04:37.32,Cap,,0,0,0,,IS CARRICK THE RIGHT
Dialogue: 0,0:04:37.32,0:04:37.95,Cap,,0,0,0,,MAN,
Dialogue: 0,0:04:37.95,0:04:38.92,Cap,,0,0,0,,OR IS THIS THE
Dialogue: 0,0:04:38.92,0:04:40.59,Cap,,0,0,0,,SAME OLD UNITED STORY?
Dialogue: 0,0:04:40.59,0:04:41.01,Cap,,0,0,0,,LET ME KNOW IN
Dialogue: 0,0:04:41.01,0:04:42.02,Cap,,0,0,0,,THE COMMENTS.
