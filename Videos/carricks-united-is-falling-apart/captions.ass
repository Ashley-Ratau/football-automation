Dialogue: 0,0:00:00.00,0:00:01.76,Cap,,0,0,0,,SIXTEENTH OF SEPTEMBER.
Dialogue: 0,0:00:01.76,0:00:03.04,Cap,,0,0,0,,OLD TRAFFORD.
Dialogue: 0,0:00:03.04,0:00:04.16,Cap,,0,0,0,,TWELVE MINUTES IN,
Dialogue: 0,0:00:04.16,0:00:06.00,Cap,,0,0,0,,MANCHESTER UNITED ARE TWO-NIL
Dialogue: 0,0:00:06.00,0:00:07.60,Cap,,0,0,0,,UP AGAINST BRIGHTON.
Dialogue: 0,0:00:07.60,0:00:09.04,Cap,,0,0,0,,THEN IT ALL FALLS
Dialogue: 0,0:00:09.04,0:00:10.08,Cap,,0,0,0,,APART.
Dialogue: 0,0:00:10.08,0:00:11.84,Cap,,0,0,0,,BRIGHTON SCORE THREE.
Dialogue: 0,0:00:11.84,0:00:13.08,Cap,,0,0,0,,UNITED ARE OUT OF
Dialogue: 0,0:00:13.08,0:00:14.40,Cap,,0,0,0,,THE CARABAO CUP.
Dialogue: 0,0:00:14.40,0:00:15.20,Cap,,0,0,0,,AND FOR THE FIRST
Dialogue: 0,0:00:15.20,0:00:16.96,Cap,,0,0,0,,TIME IN FIFTY YEARS,
Dialogue: 0,0:00:16.96,0:00:18.00,Cap,,0,0,0,,UNITED HAVE LOST A
Dialogue: 0,0:00:18.00,0:00:19.40,Cap,,0,0,0,,HOME GAME AFTER LEADING
Dialogue: 0,0:00:19.40,0:00:21.12,Cap,,0,0,0,,BY TWO GOALS.
Dialogue: 0,0:00:21.12,0:00:22.40,Cap,,0,0,0,,MICHAEL CARRICK WALKS INTO
Dialogue: 0,0:00:22.40,0:00:23.60,Cap,,0,0,0,,HIS PRESS CONFERENCE,
Dialogue: 0,0:00:23.60,0:00:24.68,Cap,,0,0,0,,AND HE DOES NOT
Dialogue: 0,0:00:24.68,0:00:25.37,Cap,,0,0,0,,HIDE.
Dialogue: 0,0:00:25.51,0:00:27.19,Cap,,0,0,0,,SO WE HAD THE
Dialogue: 0,0:00:27.19,0:00:28.05,Cap,,0,0,0,,GAME EXACTLY WHERE WE
Dialogue: 0,0:00:28.05,0:00:29.11,Cap,,0,0,0,,WANTED IT AND LET
Dialogue: 0,0:00:29.11,0:00:29.75,Cap,,0,0,0,,IT GET AWAY FROM
Dialogue: 0,0:00:29.75,0:00:31.09,Cap,,0,0,0,,US IN A BIG
Dialogue: 0,0:00:31.09,0:00:31.31,Cap,,0,0,0,,WAY.
Dialogue: 0,0:00:31.31,0:00:31.84,Cap,,0,0,0,,SO,
Dialogue: 0,0:00:32.01,0:00:33.21,Cap,,0,0,0,,EIGHT MONTHS AGO,
Dialogue: 0,0:00:33.21,0:00:34.01,Cap,,0,0,0,,THIS MAN WAS THE
Dialogue: 0,0:00:34.01,0:00:34.74,Cap,,0,0,0,,ANSWER.
Dialogue: 0,0:00:35.05,0:00:35.65,Cap,,0,0,0,,NOW,
Dialogue: 0,0:00:35.65,0:00:36.93,Cap,,0,0,0,,AFTER JUST FIVE LEAGUE
Dialogue: 0,0:00:36.93,0:00:37.53,Cap,,0,0,0,,GAMES,
Dialogue: 0,0:00:37.53,0:00:38.57,Cap,,0,0,0,,PEOPLE ARE ASKING IF
Dialogue: 0,0:00:38.57,0:00:40.26,Cap,,0,0,0,,HE IS THE PROBLEM.
Dialogue: 0,0:00:40.33,0:00:41.45,Cap,,0,0,0,,SO HOW DID CARRICK'S
Dialogue: 0,0:00:41.45,0:00:42.49,Cap,,0,0,0,,UNITED GO FROM THE
Dialogue: 0,0:00:42.49,0:00:43.21,Cap,,0,0,0,,BEST TEAM IN THE
Dialogue: 0,0:00:43.21,0:00:44.01,Cap,,0,0,0,,COUNTRY,
Dialogue: 0,0:00:44.01,0:00:45.05,Cap,,0,0,0,,TO THIS,
Dialogue: 0,0:00:45.05,0:00:46.26,Cap,,0,0,0,,SO FAST?
Dialogue: 0,0:00:46.28,0:00:47.73,Cap,,0,0,0,,GO BACK TO JANUARY.
Dialogue: 0,0:00:47.96,0:00:49.40,Cap,,0,0,0,,RUBEN AMORIM HAS JUST
Dialogue: 0,0:00:49.40,0:00:50.52,Cap,,0,0,0,,BEEN SACKED.
Dialogue: 0,0:00:50.52,0:00:51.48,Cap,,0,0,0,,THE CLUB IS IN
Dialogue: 0,0:00:51.48,0:00:52.68,Cap,,0,0,0,,CHAOS.
Dialogue: 0,0:00:52.68,0:00:53.88,Cap,,0,0,0,,UNITED TURN TO A
Dialogue: 0,0:00:53.88,0:00:54.80,Cap,,0,0,0,,FORMER PLAYER,
Dialogue: 0,0:00:54.80,0:00:56.44,Cap,,0,0,0,,WITH ONE JOB: STEADY
Dialogue: 0,0:00:56.44,0:00:57.56,Cap,,0,0,0,,THE SHIP UNTIL THE
Dialogue: 0,0:00:57.56,0:00:58.48,Cap,,0,0,0,,SUMMER.
Dialogue: 0,0:00:58.48,0:01:00.36,Cap,,0,0,0,,NOT EVERYONE WAS CONVINCED.
Dialogue: 0,0:01:00.36,0:01:01.80,Cap,,0,0,0,,ROY KEANE CERTAINLY WAS
Dialogue: 0,0:01:01.80,0:01:02.61,Cap,,0,0,0,,NOT.
Dialogue: 0,0:01:02.75,0:01:04.02,Cap,,0,0,0,,MICHAEL CARRICK,
Dialogue: 0,0:01:04.77,0:01:05.63,Cap,,0,0,0,,WHATEVER HIS REMIT WAS
Dialogue: 0,0:01:05.63,0:01:06.15,Cap,,0,0,0,,AT MIDDLESBROUGH,
Dialogue: 0,0:01:06.15,0:01:06.71,Cap,,0,0,0,,I'M PRETTY SURE IT
Dialogue: 0,0:01:06.71,0:01:07.47,Cap,,0,0,0,,WAS TO PROBABLY GET
Dialogue: 0,0:01:07.47,0:01:08.06,Cap,,0,0,0,,PROMOTED,
Dialogue: 0,0:01:08.07,0:01:09.18,Cap,,0,0,0,,HE DIDN'T DO THAT,
Dialogue: 0,0:01:09.51,0:01:10.13,Cap,,0,0,0,,SO YOU CAN SEE
Dialogue: 0,0:01:10.13,0:01:11.20,Cap,,0,0,0,,HE FAILED THERE,
Dialogue: 0,0:01:11.65,0:01:13.41,Cap,,0,0,0,,WHAT HAPPENED NEXT SURPRISED
Dialogue: 0,0:01:13.41,0:01:15.10,Cap,,0,0,0,,ALMOST EVERYONE.
Dialogue: 0,0:01:15.17,0:01:17.02,Cap,,0,0,0,,SEVENTEEN LEAGUE GAMES.
Dialogue: 0,0:01:17.17,0:01:18.29,Cap,,0,0,0,,TWELVE WINS.
Dialogue: 0,0:01:18.29,0:01:19.42,Cap,,0,0,0,,THREE DRAWS.
Dialogue: 0,0:01:19.57,0:01:21.30,Cap,,0,0,0,,JUST TWO DEFEATS.
Dialogue: 0,0:01:21.33,0:01:22.73,Cap,,0,0,0,,WINS OVER CITY,
Dialogue: 0,0:01:22.73,0:01:23.41,Cap,,0,0,0,,ARSENAL,
Dialogue: 0,0:01:23.41,0:01:25.18,Cap,,0,0,0,,LIVERPOOL AND CHELSEA.
Dialogue: 0,0:01:25.57,0:01:26.77,Cap,,0,0,0,,OVER THAT STRETCH,
Dialogue: 0,0:01:26.77,0:01:27.73,Cap,,0,0,0,,NOBODY IN THE LEAGUE
Dialogue: 0,0:01:27.73,0:01:28.94,Cap,,0,0,0,,TOOK MORE POINTS.
Dialogue: 0,0:01:29.09,0:01:30.73,Cap,,0,0,0,,UNITED FINISHED THIRD,
Dialogue: 0,0:01:30.73,0:01:31.49,Cap,,0,0,0,,AND THEY WERE BACK
Dialogue: 0,0:01:31.49,0:01:32.94,Cap,,0,0,0,,IN THE CHAMPIONS LEAGUE.
Dialogue: 0,0:01:33.02,0:01:33.62,Cap,,0,0,0,,BUT WHAT MICHAEL CARRICK
Dialogue: 0,0:01:33.62,0:01:34.24,Cap,,0,0,0,,WAS ABLE TO DO
Dialogue: 0,0:01:34.24,0:01:35.54,Cap,,0,0,0,,A FEW WEEKS LATER
Dialogue: 0,0:01:35.54,0:01:36.56,Cap,,0,0,0,,WAS REALLY JUST CALM
Dialogue: 0,0:01:36.56,0:01:38.14,Cap,,0,0,0,,ALL THE NOISE INSIDE
Dialogue: 0,0:01:38.14,0:01:39.81,Cap,,0,0,0,,AND OUTSIDE THE CLUB.
Dialogue: 0,0:01:40.26,0:01:41.74,Cap,,0,0,0,,SO UNITED GAVE HIM
Dialogue: 0,0:01:41.74,0:01:42.51,Cap,,0,0,0,,THE JOB.
Dialogue: 0,0:01:42.66,0:01:44.26,Cap,,0,0,0,,A TWO-YEAR CONTRACT,
Dialogue: 0,0:01:44.26,0:01:45.94,Cap,,0,0,0,,UNTIL TWENTY TWENTY-EIGHT.
Dialogue: 0,0:01:45.94,0:01:46.98,Cap,,0,0,0,,AND HERE IS WHERE
Dialogue: 0,0:01:46.98,0:01:48.74,Cap,,0,0,0,,THE WARNING SIGNS START.
Dialogue: 0,0:01:48.74,0:01:49.54,Cap,,0,0,0,,BECAUSE WHEN YOU LOOK
Dialogue: 0,0:01:49.54,0:01:51.18,Cap,,0,0,0,,CLOSELY AT THAT RUN,
Dialogue: 0,0:01:51.18,0:01:51.82,Cap,,0,0,0,,A LOT OF IT
Dialogue: 0,0:01:51.82,0:01:52.90,Cap,,0,0,0,,WAS BUILT ON FINDING
Dialogue: 0,0:01:52.90,0:01:54.18,Cap,,0,0,0,,A WAY TO WIN,
Dialogue: 0,0:01:54.18,0:01:56.39,Cap,,0,0,0,,NOT ON DOMINATING GAMES.
Dialogue: 0,0:01:56.42,0:01:57.34,Cap,,0,0,0,,CARRICK HAS SAID SO
Dialogue: 0,0:01:57.34,0:01:58.27,Cap,,0,0,0,,HIMSELF.
Dialogue: 0,0:01:58.41,0:02:00.29,Cap,,0,0,0,,WE WON LAST YEAR
Dialogue: 0,0:02:00.29,0:02:02.39,Cap,,0,0,0,,BY SOMETIMES NOT PLAYING
Dialogue: 0,0:02:02.39,0:02:03.41,Cap,,0,0,0,,PARTICULARLY WELL.
Dialogue: 0,0:02:03.41,0:02:03.83,Cap,,0,0,0,,WE FOUND A WAY
Dialogue: 0,0:02:03.83,0:02:04.46,Cap,,0,0,0,,TO WIN.
Dialogue: 0,0:02:04.91,0:02:06.28,Cap,,0,0,0,,THEN CAME THE SUMMER.
Dialogue: 0,0:02:06.59,0:02:07.96,Cap,,0,0,0,,CASEMIRO LEFT.
Dialogue: 0,0:02:08.19,0:02:09.39,Cap,,0,0,0,,THE MIDFIELD WAS MEANT
Dialogue: 0,0:02:09.39,0:02:10.92,Cap,,0,0,0,,TO BE THE PRIORITY.
Dialogue: 0,0:02:10.99,0:02:11.71,Cap,,0,0,0,,BUT FOR A CLUB
Dialogue: 0,0:02:11.71,0:02:12.43,Cap,,0,0,0,,ABOUT TO PLAY IN
Dialogue: 0,0:02:12.43,0:02:13.67,Cap,,0,0,0,,THE CHAMPIONS LEAGUE,
Dialogue: 0,0:02:13.67,0:02:15.68,Cap,,0,0,0,,THE WINDOW WAS CAUTIOUS.
Dialogue: 0,0:02:15.71,0:02:16.75,Cap,,0,0,0,,THE SQUAD THAT STARTED
Dialogue: 0,0:02:16.75,0:02:17.95,Cap,,0,0,0,,THIS SEASON LOOKED A
Dialogue: 0,0:02:17.95,0:02:18.95,Cap,,0,0,0,,LOT LIKE THE SQUAD
Dialogue: 0,0:02:18.95,0:02:19.95,Cap,,0,0,0,,THAT ENDED THE LAST
Dialogue: 0,0:02:19.95,0:02:20.44,Cap,,0,0,0,,ONE.
Dialogue: 0,0:02:20.59,0:02:21.71,Cap,,0,0,0,,ONLY NOW,
Dialogue: 0,0:02:21.71,0:02:22.83,Cap,,0,0,0,,EVERY OPPONENT HAD A
Dialogue: 0,0:02:22.83,0:02:24.20,Cap,,0,0,0,,SUMMER TO STUDY IT.
Dialogue: 0,0:02:24.22,0:02:25.55,Cap,,0,0,0,,OPENING DAY.
Dialogue: 0,0:02:25.58,0:02:27.51,Cap,,0,0,0,,NEWLY PROMOTED HULL CITY.
Dialogue: 0,0:02:27.74,0:02:29.51,Cap,,0,0,0,,UNITED LOSE TWO-NIL.
Dialogue: 0,0:02:29.82,0:02:30.78,Cap,,0,0,0,,A WEEK LATER,
Dialogue: 0,0:02:30.78,0:02:32.22,Cap,,0,0,0,,BRUNO FERNANDES SCORES A
Dialogue: 0,0:02:32.22,0:02:33.58,Cap,,0,0,0,,HAT-TRICK IN A FIVE-TWO
Dialogue: 0,0:02:33.58,0:02:35.10,Cap,,0,0,0,,WIN OVER IPSWICH,
Dialogue: 0,0:02:35.10,0:02:35.70,Cap,,0,0,0,,AND IT LOOKS LIKE
Dialogue: 0,0:02:35.70,0:02:36.47,Cap,,0,0,0,,A BLIP.
Dialogue: 0,0:02:36.78,0:02:37.90,Cap,,0,0,0,,IT WASN'T.
Dialogue: 0,0:02:37.90,0:02:39.10,Cap,,0,0,0,,A TWO-ALL DRAW WITH
Dialogue: 0,0:02:39.10,0:02:40.06,Cap,,0,0,0,,EVERTON.
Dialogue: 0,0:02:40.06,0:02:41.34,Cap,,0,0,0,,THEN THE DERBY,
Dialogue: 0,0:02:41.34,0:02:42.47,Cap,,0,0,0,,AT OLD TRAFFORD.
Dialogue: 0,0:02:42.78,0:02:43.70,Cap,,0,0,0,,CITY GO DOWN TO
Dialogue: 0,0:02:43.70,0:02:44.42,Cap,,0,0,0,,TEN MEN,
Dialogue: 0,0:02:44.42,0:02:46.22,Cap,,0,0,0,,AND UNITED STILL LOSE,
Dialogue: 0,0:02:46.22,0:02:46.90,Cap,,0,0,0,,ONE-NIL,
Dialogue: 0,0:02:46.90,0:02:48.15,Cap,,0,0,0,,TO A HAALAND GOAL.
Dialogue: 0,0:02:48.46,0:02:49.58,Cap,,0,0,0,,THREE DAYS LATER,
Dialogue: 0,0:02:49.58,0:02:50.39,Cap,,0,0,0,,BRIGHTON.
Dialogue: 0,0:02:50.46,0:02:51.58,Cap,,0,0,0,,AND THEN A LATE
Dialogue: 0,0:02:51.58,0:02:52.86,Cap,,0,0,0,,EQUALISER TO SCRAPE A
Dialogue: 0,0:02:52.86,0:02:54.23,Cap,,0,0,0,,DRAW AT FULHAM.
Dialogue: 0,0:02:54.25,0:02:55.29,Cap,,0,0,0,,HERE IS THE NUMBER
Dialogue: 0,0:02:55.29,0:02:56.66,Cap,,0,0,0,,THAT TELLS THE STORY.
Dialogue: 0,0:02:56.97,0:02:58.49,Cap,,0,0,0,,IN SEVENTEEN LEAGUE GAMES
Dialogue: 0,0:02:58.49,0:02:59.85,Cap,,0,0,0,,AS INTERIM MANAGER,
Dialogue: 0,0:02:59.85,0:03:01.66,Cap,,0,0,0,,CARRICK LOST TWICE.
Dialogue: 0,0:03:01.69,0:03:02.57,Cap,,0,0,0,,THIS SEASON,
Dialogue: 0,0:03:02.57,0:03:04.01,Cap,,0,0,0,,IN ALL COMPETITIONS,
Dialogue: 0,0:03:04.01,0:03:05.69,Cap,,0,0,0,,UNITED HAVE ALREADY LOST
Dialogue: 0,0:03:05.69,0:03:07.09,Cap,,0,0,0,,THREE TIMES.
Dialogue: 0,0:03:07.09,0:03:08.21,Cap,,0,0,0,,ONE WIN IN FIVE
Dialogue: 0,0:03:08.21,0:03:09.21,Cap,,0,0,0,,IN THE LEAGUE.
Dialogue: 0,0:03:09.21,0:03:10.82,Cap,,0,0,0,,TWELFTH IN THE TABLE.
Dialogue: 0,0:03:10.96,0:03:12.18,Cap,,0,0,0,,IT'S A NEW SEASON,
Dialogue: 0,0:03:12.18,0:03:13.14,Cap,,0,0,0,,IT'S A FRESH SEASON
Dialogue: 0,0:03:13.14,0:03:14.40,Cap,,0,0,0,,AND THE POINTS TALLY
Dialogue: 0,0:03:14.40,0:03:15.86,Cap,,0,0,0,,RIGHT NOW IS NOT
Dialogue: 0,0:03:15.86,0:03:16.38,Cap,,0,0,0,,WHAT WE WANT IT
Dialogue: 0,0:03:16.38,0:03:16.93,Cap,,0,0,0,,TO BE.
Dialogue: 0,0:03:17.00,0:03:18.34,Cap,,0,0,0,,SO I'M NOT HIDING
Dialogue: 0,0:03:18.34,0:03:18.86,Cap,,0,0,0,,FROM THAT,
Dialogue: 0,0:03:18.86,0:03:19.17,Cap,,0,0,0,,BUT
Dialogue: 0,0:03:19.46,0:03:21.43,Cap,,0,0,0,,SO WHAT HAS CHANGED?
Dialogue: 0,0:03:21.46,0:03:22.46,Cap,,0,0,0,,LAST SEASON,
Dialogue: 0,0:03:22.46,0:03:23.66,Cap,,0,0,0,,CARRICK'S UNITED WERE THE
Dialogue: 0,0:03:23.66,0:03:25.06,Cap,,0,0,0,,TEAM NOBODY HAD PLANNED
Dialogue: 0,0:03:25.06,0:03:25.86,Cap,,0,0,0,,FOR.
Dialogue: 0,0:03:25.86,0:03:26.90,Cap,,0,0,0,,THEY SAT DEEP,
Dialogue: 0,0:03:26.90,0:03:28.22,Cap,,0,0,0,,THEY STAYED COMPACT,
Dialogue: 0,0:03:28.22,0:03:29.18,Cap,,0,0,0,,AND THEY HURT TEAMS
Dialogue: 0,0:03:29.18,0:03:30.46,Cap,,0,0,0,,ON THE BREAK.
Dialogue: 0,0:03:30.46,0:03:31.30,Cap,,0,0,0,,THIS SEASON,
Dialogue: 0,0:03:31.30,0:03:33.06,Cap,,0,0,0,,OPPONENTS KNOW EXACTLY WHAT
Dialogue: 0,0:03:33.06,0:03:34.18,Cap,,0,0,0,,IS COMING.
Dialogue: 0,0:03:34.18,0:03:35.22,Cap,,0,0,0,,TEAMS DROP OFF AND
Dialogue: 0,0:03:35.22,0:03:36.34,Cap,,0,0,0,,MAKE UNITED HAVE THE
Dialogue: 0,0:03:36.34,0:03:36.98,Cap,,0,0,0,,BALL,
Dialogue: 0,0:03:36.98,0:03:38.38,Cap,,0,0,0,,AND UNITED HAVE STRUGGLED
Dialogue: 0,0:03:38.38,0:03:39.94,Cap,,0,0,0,,TO BREAK THEM DOWN.
Dialogue: 0,0:03:39.94,0:03:40.86,Cap,,0,0,0,,AGAINST BRIGHTON,
Dialogue: 0,0:03:40.86,0:03:42.02,Cap,,0,0,0,,AFTER GOING TWO UP
Dialogue: 0,0:03:42.02,0:03:43.30,Cap,,0,0,0,,INSIDE TEN MINUTES,
Dialogue: 0,0:03:43.30,0:03:44.22,Cap,,0,0,0,,THEY DID NOT HAVE
Dialogue: 0,0:03:44.22,0:03:45.38,Cap,,0,0,0,,ANOTHER SHOT ON TARGET
Dialogue: 0,0:03:45.38,0:03:46.82,Cap,,0,0,0,,UNTIL THE SEVENTY-SIXTH
Dialogue: 0,0:03:46.82,0:03:47.55,Cap,,0,0,0,,MINUTE.
Dialogue: 0,0:03:47.57,0:03:48.61,Cap,,0,0,0,,AND THE CROWD HAS
Dialogue: 0,0:03:48.61,0:03:49.65,Cap,,0,0,0,,NOTICED.
Dialogue: 0,0:03:49.65,0:03:50.69,Cap,,0,0,0,,AT FULL TIME AGAINST
Dialogue: 0,0:03:50.69,0:03:51.41,Cap,,0,0,0,,BRIGHTON,
Dialogue: 0,0:03:51.41,0:03:52.61,Cap,,0,0,0,,THERE WERE BOOS AROUND
Dialogue: 0,0:03:52.61,0:03:53.81,Cap,,0,0,0,,OLD TRAFFORD.
Dialogue: 0,0:03:53.81,0:03:54.93,Cap,,0,0,0,,CARRICK WAS ASKED IF
Dialogue: 0,0:03:54.93,0:03:56.22,Cap,,0,0,0,,HE COULD FEEL IT.
Dialogue: 0,0:03:56.36,0:03:57.08,Cap,,0,0,0,,WE HAVE TO ACCEPT
Dialogue: 0,0:03:57.08,0:03:57.26,Cap,,0,0,0,,IT,
Dialogue: 0,0:03:57.26,0:03:58.49,Cap,,0,0,0,,I TOTALLY ACCEPT IT.
Dialogue: 0,0:03:59.10,0:03:59.80,Cap,,0,0,0,,IT'S ON ME,
Dialogue: 0,0:03:59.80,0:04:00.40,Cap,,0,0,0,,ULTIMATELY,
Dialogue: 0,0:04:00.40,0:04:00.83,Cap,,0,0,0,,YOU KNOW,
Dialogue: 0,0:04:01.64,0:04:02.54,Cap,,0,0,0,,AS A TEAM,
Dialogue: 0,0:04:02.54,0:04:03.10,Cap,,0,0,0,,WHAT WE LOOK LIKE,
Dialogue: 0,0:04:03.10,0:04:03.83,Cap,,0,0,0,,HOW WE PLAY,
Dialogue: 0,0:04:04.18,0:04:05.45,Cap,,0,0,0,,WHAT RESULTS YOU GET.
Dialogue: 0,0:04:05.90,0:04:06.70,Cap,,0,0,0,,THIS IS THE PART
Dialogue: 0,0:04:06.70,0:04:08.22,Cap,,0,0,0,,UNITED FANS KNOW TOO
Dialogue: 0,0:04:08.22,0:04:08.87,Cap,,0,0,0,,WELL.
Dialogue: 0,0:04:09.10,0:04:10.54,Cap,,0,0,0,,A MANAGER ARRIVES.
Dialogue: 0,0:04:10.54,0:04:12.31,Cap,,0,0,0,,RESULTS COME FAST.
Dialogue: 0,0:04:12.38,0:04:13.59,Cap,,0,0,0,,HE GETS THE JOB.
Dialogue: 0,0:04:13.90,0:04:15.10,Cap,,0,0,0,,AND THEN THE CLUB
Dialogue: 0,0:04:15.10,0:04:16.42,Cap,,0,0,0,,SLIDES BACK INTO THE
Dialogue: 0,0:04:16.42,0:04:17.82,Cap,,0,0,0,,SAME SPIRAL THAT SWALLOWED
Dialogue: 0,0:04:17.82,0:04:18.58,Cap,,0,0,0,,MOYES,
Dialogue: 0,0:04:18.58,0:04:19.38,Cap,,0,0,0,,VAN GAAL,
Dialogue: 0,0:04:19.38,0:04:20.22,Cap,,0,0,0,,MOURINHO,
Dialogue: 0,0:04:20.22,0:04:21.14,Cap,,0,0,0,,SOLSKJAER,
Dialogue: 0,0:04:21.14,0:04:22.95,Cap,,0,0,0,,TEN HAG AND AMORIM.
Dialogue: 0,0:04:23.34,0:04:24.86,Cap,,0,0,0,,KEANE'S REAL WARNING WAS
Dialogue: 0,0:04:24.86,0:04:26.38,Cap,,0,0,0,,NEVER ABOUT CARRICK.
Dialogue: 0,0:04:26.38,0:04:27.10,Cap,,0,0,0,,IT WAS ABOUT THE
Dialogue: 0,0:04:27.10,0:04:28.63,Cap,,0,0,0,,CLUB AROUND HIM.
Dialogue: 0,0:04:28.73,0:04:29.41,Cap,,0,0,0,,A WORLD -CLASS MANAGER
Dialogue: 0,0:04:29.41,0:04:30.85,Cap,,0,0,0,,WON'T COME HERE HE
Dialogue: 0,0:04:30.85,0:04:31.11,Cap,,0,0,0,,WON'T,
Dialogue: 0,0:04:31.11,0:04:31.39,Cap,,0,0,0,,HE WON'T,
Dialogue: 0,0:04:31.39,0:04:31.82,Cap,,0,0,0,,A
Dialogue: 0,0:04:32.09,0:04:32.57,Cap,,0,0,0,,NOW,
Dialogue: 0,0:04:32.57,0:04:33.53,Cap,,0,0,0,,TO BE FAIR,
Dialogue: 0,0:04:33.53,0:04:35.05,Cap,,0,0,0,,IT IS FIVE LEAGUE
Dialogue: 0,0:04:35.05,0:04:35.69,Cap,,0,0,0,,GAMES.
Dialogue: 0,0:04:35.69,0:04:36.77,Cap,,0,0,0,,UNITED ARE STILL IN
Dialogue: 0,0:04:36.77,0:04:37.89,Cap,,0,0,0,,THE CHAMPIONS LEAGUE,
Dialogue: 0,0:04:37.89,0:04:38.73,Cap,,0,0,0,,AND THEY STARTED THAT
Dialogue: 0,0:04:38.73,0:04:40.09,Cap,,0,0,0,,CAMPAIGN WITH A FOUR-NIL
Dialogue: 0,0:04:40.09,0:04:40.98,Cap,,0,0,0,,WIN.
Dialogue: 0,0:04:41.05,0:04:41.97,Cap,,0,0,0,,CARRICK HAS TURNED THIS
Dialogue: 0,0:04:41.97,0:04:43.77,Cap,,0,0,0,,SQUAD AROUND ONCE BEFORE,
Dialogue: 0,0:04:43.77,0:04:44.81,Cap,,0,0,0,,AND HE BELIEVES HE
Dialogue: 0,0:04:44.81,0:04:46.10,Cap,,0,0,0,,CAN DO IT AGAIN.
Dialogue: 0,0:04:46.24,0:04:47.34,Cap,,0,0,0,,BUT IT DOESN'T HAVE
Dialogue: 0,0:04:47.34,0:04:48.13,Cap,,0,0,0,,TO BE LIKE THAT.
Dialogue: 0,0:04:48.26,0:04:48.88,Cap,,0,0,0,,IF WE WIN FOOTBALL
Dialogue: 0,0:04:48.88,0:04:49.76,Cap,,0,0,0,,MATCHES AGAIN,
Dialogue: 0,0:04:49.76,0:04:50.98,Cap,,0,0,0,,IT CAN GO IN
Dialogue: 0,0:04:50.98,0:04:51.93,Cap,,0,0,0,,A DIFFERENT DIRECTION.
Dialogue: 0,0:04:52.38,0:04:53.50,Cap,,0,0,0,,AFTER THE INTERNATIONAL
Dialogue: 0,0:04:53.50,0:04:54.14,Cap,,0,0,0,,BREAK,
Dialogue: 0,0:04:54.14,0:04:55.18,Cap,,0,0,0,,TOTTENHAM COME TO OLD
Dialogue: 0,0:04:55.18,0:04:56.30,Cap,,0,0,0,,TRAFFORD.
Dialogue: 0,0:04:56.30,0:04:56.86,Cap,,0,0,0,,WIN,
Dialogue: 0,0:04:56.86,0:04:57.86,Cap,,0,0,0,,AND THIS BECOMES A
Dialogue: 0,0:04:57.86,0:04:59.02,Cap,,0,0,0,,BAD MONTH.
Dialogue: 0,0:04:59.02,0:04:59.70,Cap,,0,0,0,,LOSE,
Dialogue: 0,0:04:59.70,0:05:00.78,Cap,,0,0,0,,AND THE QUESTIONS GET
Dialogue: 0,0:05:00.78,0:05:02.06,Cap,,0,0,0,,A LOT LOUDER.
Dialogue: 0,0:05:02.06,0:05:03.10,Cap,,0,0,0,,EIGHT MONTHS AGO,
Dialogue: 0,0:05:03.10,0:05:04.98,Cap,,0,0,0,,MICHAEL CARRICK SAVED MANCHESTER
Dialogue: 0,0:05:04.98,0:05:06.30,Cap,,0,0,0,,UNITED'S SEASON.
Dialogue: 0,0:05:06.30,0:05:07.26,Cap,,0,0,0,,NOW HE HAS TO
Dialogue: 0,0:05:07.26,0:05:08.47,Cap,,0,0,0,,SAVE HIS OWN.
Dialogue: 0,0:05:08.49,0:05:09.45,Cap,,0,0,0,,IS CARRICK THE RIGHT
Dialogue: 0,0:05:09.45,0:05:10.17,Cap,,0,0,0,,MAN,
Dialogue: 0,0:05:10.17,0:05:11.29,Cap,,0,0,0,,OR IS THIS THE
Dialogue: 0,0:05:11.29,0:05:13.21,Cap,,0,0,0,,SAME OLD UNITED STORY?
Dialogue: 0,0:05:13.21,0:05:13.69,Cap,,0,0,0,,LET ME KNOW IN
Dialogue: 0,0:05:13.69,0:05:14.82,Cap,,0,0,0,,THE COMMENTS.
