Dialogue: 0,0:00:00.00,0:00:01.68,Cap,,0,0,0,,SIXTEENTH OF SEPTEMBER.
Dialogue: 0,0:00:01.68,0:00:02.88,Cap,,0,0,0,,OLD TRAFFORD.
Dialogue: 0,0:00:02.88,0:00:03.92,Cap,,0,0,0,,TWELVE MINUTES IN,
Dialogue: 0,0:00:03.92,0:00:05.60,Cap,,0,0,0,,MANCHESTER UNITED ARE TWO-NIL
Dialogue: 0,0:00:05.60,0:00:07.13,Cap,,0,0,0,,UP AGAINST BRIGHTON.
Dialogue: 0,0:00:07.20,0:00:08.48,Cap,,0,0,0,,THEN IT ALL FALLS
Dialogue: 0,0:00:08.48,0:00:09.36,Cap,,0,0,0,,APART.
Dialogue: 0,0:00:09.36,0:00:10.88,Cap,,0,0,0,,BRIGHTON SCORE THREE.
Dialogue: 0,0:00:10.88,0:00:11.96,Cap,,0,0,0,,UNITED ARE OUT OF
Dialogue: 0,0:00:11.96,0:00:13.16,Cap,,0,0,0,,THE CARABAO CUP.
Dialogue: 0,0:00:13.16,0:00:13.92,Cap,,0,0,0,,AND FOR THE FIRST
Dialogue: 0,0:00:13.92,0:00:15.72,Cap,,0,0,0,,TIME IN FIFTY YEARS,
Dialogue: 0,0:00:15.72,0:00:16.60,Cap,,0,0,0,,UNITED HAVE LOST A
Dialogue: 0,0:00:16.60,0:00:17.80,Cap,,0,0,0,,HOME GAME AFTER LEADING
Dialogue: 0,0:00:17.80,0:00:19.36,Cap,,0,0,0,,BY TWO GOALS.
Dialogue: 0,0:00:19.36,0:00:20.40,Cap,,0,0,0,,MICHAEL CARRICK WALKS INTO
Dialogue: 0,0:00:20.40,0:00:21.60,Cap,,0,0,0,,HIS PRESS CONFERENCE,
Dialogue: 0,0:00:21.60,0:00:22.64,Cap,,0,0,0,,AND HE DOES NOT
Dialogue: 0,0:00:22.64,0:00:23.37,Cap,,0,0,0,,HIDE.
Dialogue: 0,0:00:26.71,0:00:28.39,Cap,,0,0,0,,SO WE HAD THE
Dialogue: 0,0:00:28.39,0:00:29.25,Cap,,0,0,0,,GAME EXACTLY WHERE WE
Dialogue: 0,0:00:29.25,0:00:30.31,Cap,,0,0,0,,WANTED IT AND LET
Dialogue: 0,0:00:30.31,0:00:30.95,Cap,,0,0,0,,IT GET AWAY FROM
Dialogue: 0,0:00:30.95,0:00:32.29,Cap,,0,0,0,,US IN A BIG
Dialogue: 0,0:00:32.29,0:00:32.51,Cap,,0,0,0,,WAY.
Dialogue: 0,0:00:32.51,0:00:33.04,Cap,,0,0,0,,SO,
Dialogue: 0,0:00:33.21,0:00:34.33,Cap,,0,0,0,,EIGHT MONTHS AGO,
Dialogue: 0,0:00:34.33,0:00:35.21,Cap,,0,0,0,,THIS MAN WAS THE
Dialogue: 0,0:00:35.21,0:00:36.21,Cap,,0,0,0,,ANSWER.
Dialogue: 0,0:00:36.21,0:00:36.73,Cap,,0,0,0,,NOW,
Dialogue: 0,0:00:36.73,0:00:37.97,Cap,,0,0,0,,AFTER JUST FIVE LEAGUE
Dialogue: 0,0:00:37.97,0:00:38.53,Cap,,0,0,0,,GAMES,
Dialogue: 0,0:00:38.53,0:00:39.53,Cap,,0,0,0,,PEOPLE ARE ASKING IF
Dialogue: 0,0:00:39.53,0:00:41.13,Cap,,0,0,0,,HE IS THE PROBLEM.
Dialogue: 0,0:00:41.13,0:00:42.17,Cap,,0,0,0,,SO HOW DID CARRICK'S
Dialogue: 0,0:00:42.17,0:00:43.09,Cap,,0,0,0,,UNITED GO FROM THE
Dialogue: 0,0:00:43.09,0:00:43.69,Cap,,0,0,0,,BEST TEAM IN THE
Dialogue: 0,0:00:43.69,0:00:44.49,Cap,,0,0,0,,COUNTRY,
Dialogue: 0,0:00:44.49,0:00:45.41,Cap,,0,0,0,,TO THIS,
Dialogue: 0,0:00:45.41,0:00:46.58,Cap,,0,0,0,,SO FAST?
Dialogue: 0,0:00:46.60,0:00:48.24,Cap,,0,0,0,,GO BACK TO JANUARY.
Dialogue: 0,0:00:48.24,0:00:49.56,Cap,,0,0,0,,RUBEN AMORIM HAS JUST
Dialogue: 0,0:00:49.56,0:00:50.55,Cap,,0,0,0,,BEEN SACKED.
Dialogue: 0,0:00:50.55,0:00:51.56,Cap,,0,0,0,,THE CLUB IS IN
Dialogue: 0,0:00:51.56,0:00:52.52,Cap,,0,0,0,,CHAOS.
Dialogue: 0,0:00:52.52,0:00:53.64,Cap,,0,0,0,,UNITED TURN TO A
Dialogue: 0,0:00:53.64,0:00:54.52,Cap,,0,0,0,,FORMER PLAYER,
Dialogue: 0,0:00:54.52,0:00:56.04,Cap,,0,0,0,,WITH ONE JOB: STEADY
Dialogue: 0,0:00:56.04,0:00:57.17,Cap,,0,0,0,,THE SHIP UNTIL THE
Dialogue: 0,0:00:57.28,0:00:57.72,Cap,,0,0,0,,SUMMER.
Dialogue: 0,0:00:57.72,0:00:59.80,Cap,,0,0,0,,NOT EVERYONE WAS CONVINCED.
Dialogue: 0,0:00:59.80,0:01:01.16,Cap,,0,0,0,,ROY KEANE CERTAINLY WAS
Dialogue: 0,0:01:01.16,0:01:01.81,Cap,,0,0,0,,NOT.
Dialogue: 0,0:01:01.95,0:01:03.22,Cap,,0,0,0,,MICHAEL CARRICK,
Dialogue: 0,0:01:03.97,0:01:04.83,Cap,,0,0,0,,WHATEVER HIS REMIT WAS
Dialogue: 0,0:01:04.83,0:01:05.35,Cap,,0,0,0,,AT MIDDLESBROUGH,
Dialogue: 0,0:01:05.35,0:01:05.91,Cap,,0,0,0,,I'M PRETTY SURE IT
Dialogue: 0,0:01:05.91,0:01:06.67,Cap,,0,0,0,,WAS TO PROBABLY GET
Dialogue: 0,0:01:06.67,0:01:07.26,Cap,,0,0,0,,PROMOTED,
Dialogue: 0,0:01:07.27,0:01:08.38,Cap,,0,0,0,,HE DIDN'T DO THAT,
Dialogue: 0,0:01:08.71,0:01:09.33,Cap,,0,0,0,,SO YOU CAN SEE
Dialogue: 0,0:01:09.33,0:01:10.40,Cap,,0,0,0,,HE FAILED THERE,
Dialogue: 0,0:01:10.85,0:01:12.61,Cap,,0,0,0,,WHAT HAPPENED NEXT SURPRISED
Dialogue: 0,0:01:12.61,0:01:13.98,Cap,,0,0,0,,ALMOST EVERYONE.
Dialogue: 0,0:01:14.29,0:01:16.06,Cap,,0,0,0,,SEVENTEEN LEAGUE GAMES.
Dialogue: 0,0:01:16.13,0:01:17.17,Cap,,0,0,0,,TWELVE WINS.
Dialogue: 0,0:01:17.17,0:01:18.21,Cap,,0,0,0,,THREE DRAWS.
Dialogue: 0,0:01:18.21,0:01:19.66,Cap,,0,0,0,,JUST TWO DEFEATS.
Dialogue: 0,0:01:19.89,0:01:21.13,Cap,,0,0,0,,WINS OVER CITY,
Dialogue: 0,0:01:21.13,0:01:21.73,Cap,,0,0,0,,ARSENAL,
Dialogue: 0,0:01:21.73,0:01:23.26,Cap,,0,0,0,,LIVERPOOL AND CHELSEA.
Dialogue: 0,0:01:23.57,0:01:24.77,Cap,,0,0,0,,OVER THAT STRETCH,
Dialogue: 0,0:01:24.77,0:01:25.81,Cap,,0,0,0,,NOBODY IN THE LEAGUE
Dialogue: 0,0:01:25.81,0:01:27.09,Cap,,0,0,0,,TOOK MORE POINTS.
Dialogue: 0,0:01:27.09,0:01:28.49,Cap,,0,0,0,,UNITED FINISHED THIRD,
Dialogue: 0,0:01:28.49,0:01:29.17,Cap,,0,0,0,,AND THEY WERE BACK
Dialogue: 0,0:01:29.17,0:01:30.54,Cap,,0,0,0,,IN THE CHAMPIONS LEAGUE.
Dialogue: 0,0:01:30.62,0:01:31.22,Cap,,0,0,0,,BUT WHAT MICHAEL CARRICK
Dialogue: 0,0:01:31.22,0:01:31.84,Cap,,0,0,0,,WAS ABLE TO DO
Dialogue: 0,0:01:31.84,0:01:33.14,Cap,,0,0,0,,A FEW WEEKS LATER
Dialogue: 0,0:01:33.14,0:01:34.16,Cap,,0,0,0,,WAS REALLY JUST CALM
Dialogue: 0,0:01:34.16,0:01:35.74,Cap,,0,0,0,,ALL THE NOISE INSIDE
Dialogue: 0,0:01:35.74,0:01:37.41,Cap,,0,0,0,,AND OUTSIDE THE CLUB.
Dialogue: 0,0:01:37.86,0:01:39.10,Cap,,0,0,0,,SO UNITED GAVE HIM
Dialogue: 0,0:01:39.10,0:01:39.87,Cap,,0,0,0,,THE JOB.
Dialogue: 0,0:01:39.94,0:01:41.22,Cap,,0,0,0,,A TWO-YEAR CONTRACT,
Dialogue: 0,0:01:41.22,0:01:42.90,Cap,,0,0,0,,UNTIL TWENTY TWENTY-EIGHT.
Dialogue: 0,0:01:42.90,0:01:43.90,Cap,,0,0,0,,AND HERE IS WHERE
Dialogue: 0,0:01:43.90,0:01:45.39,Cap,,0,0,0,,THE WARNING SIGNS START.
Dialogue: 0,0:01:45.54,0:01:46.38,Cap,,0,0,0,,BECAUSE WHEN YOU LOOK
Dialogue: 0,0:01:46.38,0:01:47.86,Cap,,0,0,0,,CLOSELY AT THAT RUN,
Dialogue: 0,0:01:47.86,0:01:48.42,Cap,,0,0,0,,A LOT OF IT
Dialogue: 0,0:01:48.42,0:01:49.49,Cap,,0,0,0,,WAS BUILT ON FINDING
Dialogue: 0,0:01:49.49,0:01:50.66,Cap,,0,0,0,,A WAY TO WIN,
Dialogue: 0,0:01:50.66,0:01:52.66,Cap,,0,0,0,,NOT ON DOMINATING GAMES.
Dialogue: 0,0:01:52.66,0:01:53.58,Cap,,0,0,0,,CARRICK HAS SAID SO
Dialogue: 0,0:01:53.58,0:01:54.59,Cap,,0,0,0,,HIMSELF.
Dialogue: 0,0:01:54.73,0:01:56.61,Cap,,0,0,0,,WE WON LAST YEAR
Dialogue: 0,0:01:56.61,0:01:58.71,Cap,,0,0,0,,BY SOMETIMES NOT PLAYING
Dialogue: 0,0:01:58.71,0:01:59.73,Cap,,0,0,0,,PARTICULARLY WELL.
Dialogue: 0,0:01:59.73,0:02:00.15,Cap,,0,0,0,,WE FOUND A WAY
Dialogue: 0,0:02:00.15,0:02:00.78,Cap,,0,0,0,,TO WIN.
Dialogue: 0,0:02:01.23,0:02:02.52,Cap,,0,0,0,,THEN CAME THE SUMMER.
Dialogue: 0,0:02:02.67,0:02:03.96,Cap,,0,0,0,,CASEMIRO LEFT.
Dialogue: 0,0:02:04.03,0:02:05.19,Cap,,0,0,0,,THE MIDFIELD WAS MEANT
Dialogue: 0,0:02:05.19,0:02:06.59,Cap,,0,0,0,,TO BE THE PRIORITY.
Dialogue: 0,0:02:06.59,0:02:07.39,Cap,,0,0,0,,BUT FOR A CLUB
Dialogue: 0,0:02:07.39,0:02:08.07,Cap,,0,0,0,,ABOUT TO PLAY IN
Dialogue: 0,0:02:08.07,0:02:09.19,Cap,,0,0,0,,THE CHAMPIONS LEAGUE,
Dialogue: 0,0:02:09.19,0:02:10.91,Cap,,0,0,0,,THE WINDOW WAS CAUTIOUS.
Dialogue: 0,0:02:10.91,0:02:11.95,Cap,,0,0,0,,THE SQUAD THAT STARTED
Dialogue: 0,0:02:11.95,0:02:13.07,Cap,,0,0,0,,THIS SEASON LOOKED A
Dialogue: 0,0:02:13.07,0:02:13.95,Cap,,0,0,0,,LOT LIKE THE SQUAD
Dialogue: 0,0:02:13.95,0:02:14.95,Cap,,0,0,0,,THAT ENDED THE LAST
Dialogue: 0,0:02:14.95,0:02:15.40,Cap,,0,0,0,,ONE.
Dialogue: 0,0:02:15.55,0:02:16.59,Cap,,0,0,0,,ONLY NOW,
Dialogue: 0,0:02:16.59,0:02:17.63,Cap,,0,0,0,,EVERY OPPONENT HAD A
Dialogue: 0,0:02:17.63,0:02:19.08,Cap,,0,0,0,,SUMMER TO STUDY IT.
Dialogue: 0,0:02:19.10,0:02:20.38,Cap,,0,0,0,,OPENING DAY.
Dialogue: 0,0:02:20.38,0:02:22.15,Cap,,0,0,0,,NEWLY PROMOTED HULL CITY.
Dialogue: 0,0:02:22.30,0:02:23.99,Cap,,0,0,0,,UNITED LOSE TWO-NIL.
Dialogue: 0,0:02:24.22,0:02:25.30,Cap,,0,0,0,,A WEEK LATER,
Dialogue: 0,0:02:25.30,0:02:26.46,Cap,,0,0,0,,BRUNO FERNANDES SCORES A
Dialogue: 0,0:02:26.46,0:02:27.94,Cap,,0,0,0,,HAT-TRICK IN A FIVE-TWO
Dialogue: 0,0:02:27.94,0:02:29.14,Cap,,0,0,0,,WIN OVER IPSWICH,
Dialogue: 0,0:02:29.14,0:02:29.70,Cap,,0,0,0,,AND IT LOOKS LIKE
Dialogue: 0,0:02:29.70,0:02:30.71,Cap,,0,0,0,,A BLIP.
Dialogue: 0,0:02:30.78,0:02:31.82,Cap,,0,0,0,,IT WASN'T.
Dialogue: 0,0:02:31.82,0:02:32.94,Cap,,0,0,0,,A TWO-ALL DRAW WITH
Dialogue: 0,0:02:32.94,0:02:33.82,Cap,,0,0,0,,EVERTON.
Dialogue: 0,0:02:33.82,0:02:34.78,Cap,,0,0,0,,THEN THE DERBY,
Dialogue: 0,0:02:34.78,0:02:35.83,Cap,,0,0,0,,AT OLD TRAFFORD.
Dialogue: 0,0:02:35.98,0:02:36.90,Cap,,0,0,0,,CITY GO DOWN TO
Dialogue: 0,0:02:36.90,0:02:37.46,Cap,,0,0,0,,TEN MEN,
Dialogue: 0,0:02:37.46,0:02:39.22,Cap,,0,0,0,,AND UNITED STILL LOSE,
Dialogue: 0,0:02:39.22,0:02:39.78,Cap,,0,0,0,,ONE-NIL,
Dialogue: 0,0:02:39.78,0:02:40.95,Cap,,0,0,0,,TO A HAALAND GOAL.
Dialogue: 0,0:02:41.10,0:02:42.14,Cap,,0,0,0,,THREE DAYS LATER,
Dialogue: 0,0:02:42.14,0:02:42.94,Cap,,0,0,0,,BRIGHTON.
Dialogue: 0,0:02:42.94,0:02:43.98,Cap,,0,0,0,,AND THEN A LATE
Dialogue: 0,0:02:43.98,0:02:45.10,Cap,,0,0,0,,EQUALISER TO SCRAPE A
Dialogue: 0,0:02:45.10,0:02:46.47,Cap,,0,0,0,,DRAW AT FULHAM.
Dialogue: 0,0:02:46.49,0:02:47.45,Cap,,0,0,0,,HERE IS THE NUMBER
Dialogue: 0,0:02:47.45,0:02:48.89,Cap,,0,0,0,,THAT TELLS THE STORY.
Dialogue: 0,0:02:48.89,0:02:50.33,Cap,,0,0,0,,IN SEVENTEEN LEAGUE GAMES
Dialogue: 0,0:02:50.33,0:02:51.57,Cap,,0,0,0,,AS INTERIM MANAGER,
Dialogue: 0,0:02:51.57,0:02:53.37,Cap,,0,0,0,,CARRICK LOST TWICE.
Dialogue: 0,0:02:53.37,0:02:54.17,Cap,,0,0,0,,THIS SEASON,
Dialogue: 0,0:02:54.17,0:02:55.61,Cap,,0,0,0,,IN ALL COMPETITIONS,
Dialogue: 0,0:02:55.61,0:02:57.05,Cap,,0,0,0,,UNITED HAVE ALREADY LOST
Dialogue: 0,0:02:57.05,0:02:58.18,Cap,,0,0,0,,THREE TIMES.
Dialogue: 0,0:02:58.41,0:02:59.61,Cap,,0,0,0,,ONE WIN IN FIVE
Dialogue: 0,0:02:59.61,0:03:00.42,Cap,,0,0,0,,IN THE LEAGUE.
Dialogue: 0,0:03:00.49,0:03:02.10,Cap,,0,0,0,,TWELFTH IN THE TABLE.
Dialogue: 0,0:03:02.24,0:03:03.46,Cap,,0,0,0,,IT'S A NEW SEASON,
Dialogue: 0,0:03:03.46,0:03:04.42,Cap,,0,0,0,,IT'S A FRESH SEASON
Dialogue: 0,0:03:04.42,0:03:05.68,Cap,,0,0,0,,AND THE POINTS TALLY
Dialogue: 0,0:03:05.68,0:03:07.14,Cap,,0,0,0,,RIGHT NOW IS NOT
Dialogue: 0,0:03:07.14,0:03:07.66,Cap,,0,0,0,,WHAT WE WANT IT
Dialogue: 0,0:03:07.66,0:03:08.21,Cap,,0,0,0,,TO BE.
Dialogue: 0,0:03:08.28,0:03:09.62,Cap,,0,0,0,,SO I'M NOT HIDING
Dialogue: 0,0:03:09.62,0:03:10.14,Cap,,0,0,0,,FROM THAT,
Dialogue: 0,0:03:10.14,0:03:10.45,Cap,,0,0,0,,BUT
Dialogue: 0,0:03:10.74,0:03:12.66,Cap,,0,0,0,,SO WHAT HAS CHANGED?
Dialogue: 0,0:03:12.66,0:03:13.50,Cap,,0,0,0,,LAST SEASON,
Dialogue: 0,0:03:13.50,0:03:14.62,Cap,,0,0,0,,CARRICK'S UNITED WERE THE
Dialogue: 0,0:03:14.62,0:03:16.06,Cap,,0,0,0,,TEAM NOBODY HAD PLANNED
Dialogue: 0,0:03:16.06,0:03:16.58,Cap,,0,0,0,,FOR.
Dialogue: 0,0:03:16.58,0:03:17.54,Cap,,0,0,0,,THEY SAT DEEP,
Dialogue: 0,0:03:17.54,0:03:18.78,Cap,,0,0,0,,THEY STAYED COMPACT,
Dialogue: 0,0:03:18.78,0:03:19.66,Cap,,0,0,0,,AND THEY HURT TEAMS
Dialogue: 0,0:03:19.66,0:03:20.74,Cap,,0,0,0,,ON THE BREAK.
Dialogue: 0,0:03:20.74,0:03:21.54,Cap,,0,0,0,,THIS SEASON,
Dialogue: 0,0:03:21.54,0:03:23.06,Cap,,0,0,0,,OPPONENTS KNOW EXACTLY WHAT
Dialogue: 0,0:03:23.06,0:03:23.94,Cap,,0,0,0,,IS COMING.
Dialogue: 0,0:03:23.94,0:03:24.98,Cap,,0,0,0,,TEAMS DROP OFF AND
Dialogue: 0,0:03:24.98,0:03:25.94,Cap,,0,0,0,,MAKE UNITED HAVE THE
Dialogue: 0,0:03:25.94,0:03:26.46,Cap,,0,0,0,,BALL,
Dialogue: 0,0:03:26.46,0:03:27.74,Cap,,0,0,0,,AND UNITED HAVE STRUGGLED
Dialogue: 0,0:03:27.74,0:03:29.06,Cap,,0,0,0,,TO BREAK THEM DOWN.
Dialogue: 0,0:03:29.06,0:03:29.94,Cap,,0,0,0,,AGAINST BRIGHTON,
Dialogue: 0,0:03:29.94,0:03:30.94,Cap,,0,0,0,,AFTER GOING TWO UP
Dialogue: 0,0:03:30.94,0:03:32.10,Cap,,0,0,0,,INSIDE TEN MINUTES,
Dialogue: 0,0:03:32.10,0:03:33.02,Cap,,0,0,0,,THEY DID NOT HAVE
Dialogue: 0,0:03:33.02,0:03:34.10,Cap,,0,0,0,,ANOTHER SHOT ON TARGET
Dialogue: 0,0:03:34.10,0:03:35.46,Cap,,0,0,0,,UNTIL THE SEVENTY-SIXTH
Dialogue: 0,0:03:35.46,0:03:36.27,Cap,,0,0,0,,MINUTE.
Dialogue: 0,0:03:36.29,0:03:37.25,Cap,,0,0,0,,AND THE CROWD HAS
Dialogue: 0,0:03:37.25,0:03:38.25,Cap,,0,0,0,,NOTICED.
Dialogue: 0,0:03:38.25,0:03:39.17,Cap,,0,0,0,,AT FULL TIME AGAINST
Dialogue: 0,0:03:39.17,0:03:39.85,Cap,,0,0,0,,BRIGHTON,
Dialogue: 0,0:03:39.85,0:03:40.93,Cap,,0,0,0,,THERE WERE BOOS AROUND
Dialogue: 0,0:03:40.93,0:03:42.09,Cap,,0,0,0,,OLD TRAFFORD.
Dialogue: 0,0:03:42.09,0:03:43.05,Cap,,0,0,0,,CARRICK WAS ASKED IF
Dialogue: 0,0:03:43.05,0:03:44.30,Cap,,0,0,0,,HE COULD FEEL IT.
Dialogue: 0,0:03:44.44,0:03:45.16,Cap,,0,0,0,,WE HAVE TO ACCEPT
Dialogue: 0,0:03:45.16,0:03:45.34,Cap,,0,0,0,,IT,
Dialogue: 0,0:03:45.34,0:03:46.57,Cap,,0,0,0,,I TOTALLY ACCEPT IT.
Dialogue: 0,0:03:47.18,0:03:47.88,Cap,,0,0,0,,IT'S ON ME,
Dialogue: 0,0:03:47.88,0:03:48.48,Cap,,0,0,0,,ULTIMATELY,
Dialogue: 0,0:03:48.48,0:03:48.91,Cap,,0,0,0,,YOU KNOW,
Dialogue: 0,0:03:49.72,0:03:50.62,Cap,,0,0,0,,AS A TEAM,
Dialogue: 0,0:03:50.62,0:03:51.18,Cap,,0,0,0,,WHAT WE LOOK LIKE,
Dialogue: 0,0:03:51.18,0:03:51.91,Cap,,0,0,0,,HOW WE PLAY,
Dialogue: 0,0:03:52.26,0:03:53.53,Cap,,0,0,0,,WHAT RESULTS YOU GET.
Dialogue: 0,0:03:53.98,0:03:54.78,Cap,,0,0,0,,THIS IS THE PART
Dialogue: 0,0:03:54.78,0:03:56.14,Cap,,0,0,0,,UNITED FANS KNOW TOO
Dialogue: 0,0:03:56.14,0:03:56.86,Cap,,0,0,0,,WELL.
Dialogue: 0,0:03:56.86,0:03:58.22,Cap,,0,0,0,,A MANAGER ARRIVES.
Dialogue: 0,0:03:58.22,0:03:59.66,Cap,,0,0,0,,RESULTS COME FAST.
Dialogue: 0,0:03:59.66,0:04:01.02,Cap,,0,0,0,,HE GETS THE JOB.
Dialogue: 0,0:04:01.02,0:04:01.90,Cap,,0,0,0,,AND THEN THE CLUB
Dialogue: 0,0:04:01.90,0:04:03.02,Cap,,0,0,0,,SLIDES BACK INTO THE
Dialogue: 0,0:04:03.02,0:04:04.38,Cap,,0,0,0,,SAME SPIRAL THAT SWALLOWED
Dialogue: 0,0:04:04.38,0:04:05.02,Cap,,0,0,0,,MOYES,
Dialogue: 0,0:04:05.02,0:04:05.90,Cap,,0,0,0,,VAN GAAL,
Dialogue: 0,0:04:05.90,0:04:06.70,Cap,,0,0,0,,MOURINHO,
Dialogue: 0,0:04:06.70,0:04:07.54,Cap,,0,0,0,,SOLSKJAER,
Dialogue: 0,0:04:07.54,0:04:09.19,Cap,,0,0,0,,TEN HAG AND AMORIM.
Dialogue: 0,0:04:09.50,0:04:10.86,Cap,,0,0,0,,KEANE'S REAL WARNING WAS
Dialogue: 0,0:04:10.86,0:04:12.22,Cap,,0,0,0,,NEVER ABOUT CARRICK.
Dialogue: 0,0:04:12.22,0:04:12.90,Cap,,0,0,0,,IT WAS ABOUT THE
Dialogue: 0,0:04:12.90,0:04:14.23,Cap,,0,0,0,,CLUB AROUND HIM.
Dialogue: 0,0:04:14.33,0:04:15.01,Cap,,0,0,0,,A WORLD -CLASS MANAGER
Dialogue: 0,0:04:15.01,0:04:16.45,Cap,,0,0,0,,WON'T COME HERE HE
Dialogue: 0,0:04:16.45,0:04:16.71,Cap,,0,0,0,,WON'T,
Dialogue: 0,0:04:16.71,0:04:16.99,Cap,,0,0,0,,HE WON'T,
Dialogue: 0,0:04:16.99,0:04:17.42,Cap,,0,0,0,,A
Dialogue: 0,0:04:17.69,0:04:18.13,Cap,,0,0,0,,NOW,
Dialogue: 0,0:04:18.13,0:04:19.09,Cap,,0,0,0,,TO BE FAIR,
Dialogue: 0,0:04:19.09,0:04:20.33,Cap,,0,0,0,,IT IS FIVE LEAGUE
Dialogue: 0,0:04:20.33,0:04:21.06,Cap,,0,0,0,,GAMES.
Dialogue: 0,0:04:21.21,0:04:22.17,Cap,,0,0,0,,UNITED ARE STILL IN
Dialogue: 0,0:04:22.17,0:04:23.25,Cap,,0,0,0,,THE CHAMPIONS LEAGUE,
Dialogue: 0,0:04:23.25,0:04:24.17,Cap,,0,0,0,,AND THEY STARTED THAT
Dialogue: 0,0:04:24.17,0:04:25.45,Cap,,0,0,0,,CAMPAIGN WITH A FOUR-NIL
Dialogue: 0,0:04:25.45,0:04:26.02,Cap,,0,0,0,,WIN.
Dialogue: 0,0:04:26.25,0:04:27.17,Cap,,0,0,0,,CARRICK HAS TURNED THIS
Dialogue: 0,0:04:27.17,0:04:28.93,Cap,,0,0,0,,SQUAD AROUND ONCE BEFORE,
Dialogue: 0,0:04:28.93,0:04:29.77,Cap,,0,0,0,,AND HE BELIEVES HE
Dialogue: 0,0:04:29.77,0:04:30.90,Cap,,0,0,0,,CAN DO IT AGAIN.
Dialogue: 0,0:04:31.12,0:04:32.22,Cap,,0,0,0,,BUT IT DOESN'T HAVE
Dialogue: 0,0:04:32.22,0:04:33.01,Cap,,0,0,0,,TO BE LIKE THAT.
Dialogue: 0,0:04:33.14,0:04:33.76,Cap,,0,0,0,,IF WE WIN FOOTBALL
Dialogue: 0,0:04:33.76,0:04:34.64,Cap,,0,0,0,,MATCHES AGAIN,
Dialogue: 0,0:04:34.64,0:04:35.86,Cap,,0,0,0,,IT CAN GO IN
Dialogue: 0,0:04:35.86,0:04:36.81,Cap,,0,0,0,,A DIFFERENT DIRECTION.
Dialogue: 0,0:04:37.26,0:04:38.30,Cap,,0,0,0,,AFTER THE INTERNATIONAL
Dialogue: 0,0:04:38.30,0:04:38.90,Cap,,0,0,0,,BREAK,
Dialogue: 0,0:04:38.90,0:04:39.90,Cap,,0,0,0,,TOTTENHAM COME TO OLD
Dialogue: 0,0:04:39.90,0:04:41.02,Cap,,0,0,0,,TRAFFORD.
Dialogue: 0,0:04:41.02,0:04:41.54,Cap,,0,0,0,,WIN,
Dialogue: 0,0:04:41.54,0:04:42.50,Cap,,0,0,0,,AND THIS BECOMES A
Dialogue: 0,0:04:42.50,0:04:43.50,Cap,,0,0,0,,BAD MONTH.
Dialogue: 0,0:04:43.50,0:04:44.18,Cap,,0,0,0,,LOSE,
Dialogue: 0,0:04:44.18,0:04:45.18,Cap,,0,0,0,,AND THE QUESTIONS GET
Dialogue: 0,0:04:45.18,0:04:46.70,Cap,,0,0,0,,A LOT LOUDER.
Dialogue: 0,0:04:46.70,0:04:47.70,Cap,,0,0,0,,EIGHT MONTHS AGO,
Dialogue: 0,0:04:47.70,0:04:49.38,Cap,,0,0,0,,MICHAEL CARRICK SAVED MANCHESTER
Dialogue: 0,0:04:49.38,0:04:50.66,Cap,,0,0,0,,UNITED'S SEASON.
Dialogue: 0,0:04:50.66,0:04:51.54,Cap,,0,0,0,,NOW HE HAS TO
Dialogue: 0,0:04:51.54,0:04:52.63,Cap,,0,0,0,,SAVE HIS OWN.
Dialogue: 0,0:04:52.65,0:04:53.69,Cap,,0,0,0,,IS CARRICK THE RIGHT
Dialogue: 0,0:04:53.69,0:04:54.29,Cap,,0,0,0,,MAN,
Dialogue: 0,0:04:54.29,0:04:55.21,Cap,,0,0,0,,OR IS THIS THE
Dialogue: 0,0:04:55.21,0:04:56.97,Cap,,0,0,0,,SAME OLD UNITED STORY?
Dialogue: 0,0:04:56.97,0:04:57.41,Cap,,0,0,0,,LET ME KNOW IN
Dialogue: 0,0:04:57.41,0:04:58.50,Cap,,0,0,0,,THE COMMENTS.
