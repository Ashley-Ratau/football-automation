Dialogue: 0,0:00:00.12,0:00:02.84,Cap,,0,0,0,,YOU AND I CELEBRATED
Dialogue: 0,0:00:02.84,0:00:04.70,Cap,,0,0,0,,SUPER CHAMPIONS WHO WERE
Dialogue: 0,0:00:04.70,0:00:06.28,Cap,,0,0,0,,IN FACT MAYBE ONLY
Dialogue: 0,0:00:06.28,0:00:10.18,Cap,,0,0,0,,CHEATS AND WHEN YOU
Dialogue: 0,0:00:10.18,0:00:11.74,Cap,,0,0,0,,WIN SPORT YOU SUFFER
Dialogue: 0,0:00:11.74,0:00:12.80,Cap,,0,0,0,,WHEN YOU DON'T WIN
Dialogue: 0,0:00:12.80,0:00:14.30,Cap,,0,0,0,,SO AT LEAST YOU
Dialogue: 0,0:00:14.30,0:00:15.02,Cap,,0,0,0,,WANT TO KNOW THAT
Dialogue: 0,0:00:15.02,0:00:15.74,Cap,,0,0,0,,THE GUY WHO WINS
Dialogue: 0,0:00:15.74,0:00:16.70,Cap,,0,0,0,,IS BETTER THAN YOU
Dialogue: 0,0:00:16.70,0:00:18.41,Cap,,0,0,0,,WITHOUT CHEATING AND ON
Dialogue: 0,0:00:18.41,0:00:19.88,Cap,,0,0,0,,THE TWENTY-NINTH OF SEPTEMBER,
Dialogue: 0,0:00:19.88,0:00:21.25,Cap,,0,0,0,,AN INDEPENDENT COMMISSION
Dialogue: 0,0:00:21.25,0:00:21.89,Cap,,0,0,0,,RULED THAT,
Dialogue: 0,0:00:21.89,0:00:23.26,Cap,,0,0,0,,FOR NINE SEASONS,
Dialogue: 0,0:00:23.26,0:00:25.00,Cap,,0,0,0,,MANCHESTER CITY USED SHAM
Dialogue: 0,0:00:25.00,0:00:26.66,Cap,,0,0,0,,SPONSORSHIP DEALS TO HIDE
Dialogue: 0,0:00:26.66,0:00:28.33,Cap,,0,0,0,,MONEY FROM THEIR OWNERS.
Dialogue: 0,0:00:28.36,0:00:29.52,Cap,,0,0,0,,MORE THAN NINE HUNDRED
Dialogue: 0,0:00:29.52,0:00:30.71,Cap,,0,0,0,,MILLION POUNDS.
Dialogue: 0,0:00:30.71,0:00:31.88,Cap,,0,0,0,,FROM TWO THOUSAND AND
Dialogue: 0,0:00:31.88,0:00:32.51,Cap,,0,0,0,,NINE,
Dialogue: 0,0:00:32.51,0:00:33.97,Cap,,0,0,0,,TO TWENTY EIGHTEEN.
Dialogue: 0,0:00:34.23,0:00:35.54,Cap,,0,0,0,,THE LAST NINE SEASONS
Dialogue: 0,0:00:35.54,0:00:36.89,Cap,,0,0,0,,OF ARSÈNE WENGER'S TIME
Dialogue: 0,0:00:36.89,0:00:37.86,Cap,,0,0,0,,AT ARSENAL.
Dialogue: 0,0:00:37.93,0:00:39.00,Cap,,0,0,0,,THE YEARS HE SPENT
Dialogue: 0,0:00:39.00,0:00:40.53,Cap,,0,0,0,,LOSING PLAYERS TO CITY,
Dialogue: 0,0:00:40.53,0:00:41.98,Cap,,0,0,0,,LOSING GROUND TO CITY,
Dialogue: 0,0:00:41.98,0:00:43.20,Cap,,0,0,0,,AND WARNING ANYONE WHO
Dialogue: 0,0:00:43.20,0:00:44.08,Cap,,0,0,0,,WOULD LISTEN.
Dialogue: 0,0:00:44.27,0:00:46.10,Cap,,0,0,0,,ALMOST NOBODY DID.
Dialogue: 0,0:00:49.40,0:00:50.60,Cap,,0,0,0,,TO UNDERSTAND WHY THIS
Dialogue: 0,0:00:50.60,0:00:51.80,Cap,,0,0,0,,HURTS ARSENAL FANS SO
Dialogue: 0,0:00:51.80,0:00:52.49,Cap,,0,0,0,,MUCH,
Dialogue: 0,0:00:52.49,0:00:53.11,Cap,,0,0,0,,GO BACK TO THE
Dialogue: 0,0:00:53.11,0:00:54.24,Cap,,0,0,0,,DAY HE ARRIVED.
Dialogue: 0,0:00:54.24,0:00:56.52,Cap,,0,0,0,,SEPTEMBER NINETEEN NINETY-SIX.
Dialogue: 0,0:00:56.52,0:00:57.67,Cap,,0,0,0,,ARSENAL UNVEIL THEIR NEW
Dialogue: 0,0:00:57.67,0:00:58.33,Cap,,0,0,0,,MANAGER,
Dialogue: 0,0:00:58.33,0:00:59.41,Cap,,0,0,0,,AND A REPORTER ASKS
Dialogue: 0,0:00:59.41,0:00:59.89,Cap,,0,0,0,,IF HE WILL BE
Dialogue: 0,0:00:59.89,0:01:01.12,Cap,,0,0,0,,SPENDING BIG.
Dialogue: 0,0:01:01.34,0:01:01.94,Cap,,0,0,0,,OF COURSE WHEN YOU
Dialogue: 0,0:01:01.94,0:01:02.90,Cap,,0,0,0,,WHEN YOU BUY BIG
Dialogue: 0,0:01:02.90,0:01:04.62,Cap,,0,0,0,,NAMES EVERYBODY'S FULL OF
Dialogue: 0,0:01:04.62,0:01:05.64,Cap,,0,0,0,,HOPE AND MANY TIMES
Dialogue: 0,0:01:05.64,0:01:06.46,Cap,,0,0,0,,WHO ARE DISAPPOINTED.
Dialogue: 0,0:01:06.46,0:01:07.38,Cap,,0,0,0,,YOU CANNOT BUY SUCCESS
Dialogue: 0,0:01:07.38,0:01:08.32,Cap,,0,0,0,,JUST BY BUYING BIG
Dialogue: 0,0:01:08.32,0:01:08.99,Cap,,0,0,0,,NAMES
Dialogue: 0,0:01:09.44,0:01:10.42,Cap,,0,0,0,,FOR TEN YEARS,
Dialogue: 0,0:01:10.42,0:01:11.35,Cap,,0,0,0,,THAT WORKED.
Dialogue: 0,0:01:11.35,0:01:12.41,Cap,,0,0,0,,THREE LEAGUE TITLES.
Dialogue: 0,0:01:12.41,0:01:13.55,Cap,,0,0,0,,THE INVINCIBLES.
Dialogue: 0,0:01:13.55,0:01:14.67,Cap,,0,0,0,,THEN ARSENAL DID SOMETHING
Dialogue: 0,0:01:14.67,0:01:15.62,Cap,,0,0,0,,RESPONSIBLE.
Dialogue: 0,0:01:15.62,0:01:16.44,Cap,,0,0,0,,THEY BORROWED TO BUILD
Dialogue: 0,0:01:16.44,0:01:17.33,Cap,,0,0,0,,A NEW STADIUM,
Dialogue: 0,0:01:17.33,0:01:18.12,Cap,,0,0,0,,AND THEY TIGHTENED THE
Dialogue: 0,0:01:18.12,0:01:19.23,Cap,,0,0,0,,BUDGET TO PAY FOR
Dialogue: 0,0:01:19.23,0:01:19.69,Cap,,0,0,0,,IT.
Dialogue: 0,0:01:19.76,0:01:20.67,Cap,,0,0,0,,IN HIS OWN WORDS,
Dialogue: 0,0:01:20.67,0:01:21.76,Cap,,0,0,0,,YEARS LATER,
Dialogue: 0,0:01:21.83,0:01:22.84,Cap,,0,0,0,,THIS IS WHEN EVERYTHING
Dialogue: 0,0:01:22.84,0:01:23.90,Cap,,0,0,0,,CHANGED.
Dialogue: 0,0:01:24.12,0:01:25.30,Cap,,0,0,0,,WE BUILT A NEW
Dialogue: 0,0:01:25.30,0:01:26.84,Cap,,0,0,0,,STADIUM AND YOU WERE
Dialogue: 0,0:01:26.84,0:01:28.08,Cap,,0,0,0,,PLACED TO KNOW THAT
Dialogue: 0,0:01:28.08,0:01:29.59,Cap,,0,0,0,,WE HAD RESTRICTED FINANCES,
Dialogue: 0,0:01:29.62,0:01:30.16,Cap,,0,0,0,,HAD TO SELL OUR
Dialogue: 0,0:01:30.16,0:01:31.03,Cap,,0,0,0,,BEST PLAYERS.
Dialogue: 0,0:01:31.70,0:01:33.02,Cap,,0,0,0,,AND THE SECOND ONE
Dialogue: 0,0:01:33.02,0:01:35.14,Cap,,0,0,0,,IS THAT BIG INVESTORS
Dialogue: 0,0:01:35.14,0:01:35.86,Cap,,0,0,0,,CAME IN AT THE
Dialogue: 0,0:01:35.86,0:01:36.85,Cap,,0,0,0,,SAME TIME,
Dialogue: 0,0:01:38.40,0:01:39.15,Cap,,0,0,0,,LIKE CHELSEA,
Dialogue: 0,0:01:39.26,0:01:40.61,Cap,,0,0,0,,LIKE MAN CITY AFTER,
Dialogue: 0,0:01:41.12,0:01:42.72,Cap,,0,0,0,,WHO WERE HUGELY AMBITIOUS
Dialogue: 0,0:01:42.72,0:01:44.22,Cap,,0,0,0,,AND WE WERE NOT
Dialogue: 0,0:01:44.22,0:01:46.82,Cap,,0,0,0,,ANYMORE THE CLUB WHO
Dialogue: 0,0:01:46.82,0:01:49.58,Cap,,0,0,0,,COULD BASICALLY COMPETE
Dialogue: 0,0:01:49.58,0:01:50.24,Cap,,0,0,0,,WITH THEM ON THE
Dialogue: 0,0:01:50.24,0:01:51.10,Cap,,0,0,0,,FINANCIAL FRONT,
Dialogue: 0,0:01:51.10,0:01:52.77,Cap,,0,0,0,,TODAY SEPTEMBER TWO THOUSAND
Dialogue: 0,0:01:52.77,0:01:53.51,Cap,,0,0,0,,AND EIGHT.
Dialogue: 0,0:01:53.51,0:01:55.23,Cap,,0,0,0,,ABU DHABI BUYS MANCHESTER
Dialogue: 0,0:01:55.23,0:01:55.79,Cap,,0,0,0,,CITY.
Dialogue: 0,0:01:55.79,0:01:56.74,Cap,,0,0,0,,WITHIN A YEAR,
Dialogue: 0,0:01:56.74,0:01:57.87,Cap,,0,0,0,,CITY COME FOR ARSENAL'S
Dialogue: 0,0:01:57.87,0:01:58.66,Cap,,0,0,0,,SQUAD.
Dialogue: 0,0:01:58.73,0:01:59.64,Cap,,0,0,0,,JULY TWO THOUSAND AND
Dialogue: 0,0:01:59.64,0:02:00.33,Cap,,0,0,0,,NINE.
Dialogue: 0,0:02:00.41,0:02:02.04,Cap,,0,0,0,,EMMANUEL ADEBAYOR,
Dialogue: 0,0:02:02.04,0:02:03.84,Cap,,0,0,0,,TWENTY-FIVE MILLION POUNDS.
Dialogue: 0,0:02:03.87,0:02:05.01,Cap,,0,0,0,,KOLO TOURÉ,
Dialogue: 0,0:02:05.01,0:02:06.22,Cap,,0,0,0,,SIXTEEN MILLION.
Dialogue: 0,0:02:06.35,0:02:07.45,Cap,,0,0,0,,TWO MONTHS LATER,
Dialogue: 0,0:02:07.45,0:02:08.79,Cap,,0,0,0,,ADEBAYOR SCORES AGAINST
Dialogue: 0,0:02:08.79,0:02:10.23,Cap,,0,0,0,,ARSENAL AND SPRINTS THE
Dialogue: 0,0:02:10.23,0:02:10.97,Cap,,0,0,0,,LENGTH OF THE PITCH
Dialogue: 0,0:02:10.97,0:02:11.90,Cap,,0,0,0,,TO CELEBRATE IN FRONT
Dialogue: 0,0:02:11.90,0:02:12.68,Cap,,0,0,0,,OF THE FANS WHO
Dialogue: 0,0:02:12.68,0:02:13.41,Cap,,0,0,0,,USED TO SING HIS
Dialogue: 0,0:02:13.41,0:02:14.06,Cap,,0,0,0,,NAME.
Dialogue: 0,0:02:14.51,0:02:15.90,Cap,,0,0,0,,WENGER IS ASKED ABOUT
Dialogue: 0,0:02:15.90,0:02:17.35,Cap,,0,0,0,,THE PLAYERS HE LOST.
Dialogue: 0,0:02:17.48,0:02:18.99,Cap,,0,0,0,,HE DOES NOT COMPLAIN.
Dialogue: 0,0:02:19.21,0:02:20.01,Cap,,0,0,0,,I WISH ALWAYS MY
Dialogue: 0,0:02:20.01,0:02:20.99,Cap,,0,0,0,,FORMER PLAYERS TO BE
Dialogue: 0,0:02:20.99,0:02:25.03,Cap,,0,0,0,,HAPPY AND THAT'S PART
Dialogue: 0,0:02:25.03,0:02:25.63,Cap,,0,0,0,,OF LIFE,
Dialogue: 0,0:02:25.63,0:02:26.92,Cap,,0,0,0,,THAT PLAYERS MOVE ON,
Dialogue: 0,0:02:27.31,0:02:28.39,Cap,,0,0,0,,THAT'S NOT THE REASON
Dialogue: 0,0:02:28.39,0:02:30.07,Cap,,0,0,0,,THAT YOU WANT THEM
Dialogue: 0,0:02:30.07,0:02:31.91,Cap,,0,0,0,,NOT TO BE HAPPY.
Dialogue: 0,0:02:31.91,0:02:33.35,Cap,,0,0,0,,I BUT BY TWENTY
Dialogue: 0,0:02:33.35,0:02:34.04,Cap,,0,0,0,,ELEVEN,
Dialogue: 0,0:02:34.04,0:02:34.83,Cap,,0,0,0,,HE HAD STOPPED BEING
Dialogue: 0,0:02:34.83,0:02:36.20,Cap,,0,0,0,,POLITE ABOUT THE MONEY.
Dialogue: 0,0:02:36.28,0:02:37.12,Cap,,0,0,0,,THAT JULY,
Dialogue: 0,0:02:37.12,0:02:38.15,Cap,,0,0,0,,CITY ANNOUNCED A NEW
Dialogue: 0,0:02:38.15,0:02:39.12,Cap,,0,0,0,,DEAL WITH ETIHAD,
Dialogue: 0,0:02:39.12,0:02:40.04,Cap,,0,0,0,,THE AIRLINE OF THEIR
Dialogue: 0,0:02:40.04,0:02:41.38,Cap,,0,0,0,,OWNERS' HOME STATE.
Dialogue: 0,0:02:41.41,0:02:41.97,Cap,,0,0,0,,SHIRT,
Dialogue: 0,0:02:41.97,0:02:42.88,Cap,,0,0,0,,STADIUM NAME,
Dialogue: 0,0:02:42.88,0:02:44.04,Cap,,0,0,0,,THE WHOLE CAMPUS.
Dialogue: 0,0:02:44.04,0:02:45.31,Cap,,0,0,0,,REPORTED AT AROUND FOUR
Dialogue: 0,0:02:45.31,0:02:46.60,Cap,,0,0,0,,HUNDRED MILLION POUNDS OVER
Dialogue: 0,0:02:46.60,0:02:47.66,Cap,,0,0,0,,TEN YEARS.
Dialogue: 0,0:02:47.69,0:02:48.66,Cap,,0,0,0,,WENGER WAS ASKED ABOUT
Dialogue: 0,0:02:48.66,0:02:48.91,Cap,,0,0,0,,IT,
Dialogue: 0,0:02:48.91,0:02:49.82,Cap,,0,0,0,,AND HE SAID EXACTLY
Dialogue: 0,0:02:49.82,0:02:50.66,Cap,,0,0,0,,WHAT THE COMMISSION WOULD
Dialogue: 0,0:02:50.66,0:02:51.31,Cap,,0,0,0,,FIND,
Dialogue: 0,0:02:51.31,0:02:52.55,Cap,,0,0,0,,FIFTEEN YEARS LATER.
Dialogue: 0,0:03:00.45,0:03:01.62,Cap,,0,0,0,,READ THAT AGAIN.
Dialogue: 0,0:03:01.69,0:03:02.96,Cap,,0,0,0,,SPONSORSHIP AT THE MARKET
Dialogue: 0,0:03:02.96,0:03:03.74,Cap,,0,0,0,,PRICE.
Dialogue: 0,0:03:03.87,0:03:04.64,Cap,,0,0,0,,THAT IS THE HEART
Dialogue: 0,0:03:04.64,0:03:05.84,Cap,,0,0,0,,OF THE TWENTY TWENTY-SIX
Dialogue: 0,0:03:05.84,0:03:06.68,Cap,,0,0,0,,VERDICT.
Dialogue: 0,0:03:06.75,0:03:07.62,Cap,,0,0,0,,DEALS THAT LOOKED LIKE
Dialogue: 0,0:03:07.62,0:03:08.47,Cap,,0,0,0,,SPONSORSHIP,
Dialogue: 0,0:03:08.47,0:03:09.54,Cap,,0,0,0,,WHERE THE COMMISSION SAYS
Dialogue: 0,0:03:09.54,0:03:10.42,Cap,,0,0,0,,THE REAL MONEY CAME
Dialogue: 0,0:03:10.42,0:03:11.64,Cap,,0,0,0,,FROM SOMEWHERE ELSE.
Dialogue: 0,0:03:11.66,0:03:12.86,Cap,,0,0,0,,AND THE SAME SUMMER
Dialogue: 0,0:03:12.86,0:03:14.18,Cap,,0,0,0,,WENGER SAID IT,
Dialogue: 0,0:03:14.18,0:03:15.17,Cap,,0,0,0,,CITY TOOK TWO MORE
Dialogue: 0,0:03:15.17,0:03:16.30,Cap,,0,0,0,,OF HIS PLAYERS.
Dialogue: 0,0:03:16.56,0:03:17.62,Cap,,0,0,0,,GAËL CLICHY.
Dialogue: 0,0:03:17.62,0:03:18.63,Cap,,0,0,0,,THEN SAMIR NASRI,
Dialogue: 0,0:03:18.63,0:03:19.34,Cap,,0,0,0,,A FEW DAYS AFTER
Dialogue: 0,0:03:19.34,0:03:20.62,Cap,,0,0,0,,WENGER SAID THIS.
Dialogue: 0,0:03:20.84,0:03:22.00,Cap,,0,0,0,,IDEALLY I WANT SAMIR
Dialogue: 0,0:03:22.00,0:03:23.58,Cap,,0,0,0,,NASRI TO STAY BUT
Dialogue: 0,0:03:23.58,0:03:24.76,Cap,,0,0,0,,NINE MONTHS LATER,
Dialogue: 0,0:03:24.76,0:03:26.01,Cap,,0,0,0,,CITY WERE CHAMPIONS.
Dialogue: 0,0:03:26.01,0:03:26.98,Cap,,0,0,0,,THEIR FIRST LEAGUE TITLE
Dialogue: 0,0:03:26.98,0:03:28.17,Cap,,0,0,0,,IN FORTY-FOUR YEARS,
Dialogue: 0,0:03:28.17,0:03:29.40,Cap,,0,0,0,,WITH NASRI AND CLICHY
Dialogue: 0,0:03:29.40,0:03:30.39,Cap,,0,0,0,,IN THE SQUAD.
Dialogue: 0,0:03:30.47,0:03:31.22,Cap,,0,0,0,,THEY WON IT AGAIN
Dialogue: 0,0:03:31.22,0:03:32.44,Cap,,0,0,0,,IN TWENTY FOURTEEN,
Dialogue: 0,0:03:32.44,0:03:33.66,Cap,,0,0,0,,THE SUMMER BACARY SAGNA
Dialogue: 0,0:03:33.66,0:03:34.78,Cap,,0,0,0,,LEFT ARSENAL FOR CITY
Dialogue: 0,0:03:34.78,0:03:35.72,Cap,,0,0,0,,ON A FREE.
Dialogue: 0,0:03:35.79,0:03:36.93,Cap,,0,0,0,,AND AGAIN IN TWENTY
Dialogue: 0,0:03:36.93,0:03:37.68,Cap,,0,0,0,,EIGHTEEN,
Dialogue: 0,0:03:37.68,0:03:39.10,Cap,,0,0,0,,WITH A HUNDRED POINTS.
Dialogue: 0,0:03:39.23,0:03:40.00,Cap,,0,0,0,,EVERY ONE OF THOSE
Dialogue: 0,0:03:40.00,0:03:41.24,Cap,,0,0,0,,TITLES CAME INSIDE THE
Dialogue: 0,0:03:41.24,0:03:42.70,Cap,,0,0,0,,NINE SEASONS THE COMMISSION
Dialogue: 0,0:03:42.70,0:03:43.96,Cap,,0,0,0,,HAS NOW RULED ON.
Dialogue: 0,0:03:44.10,0:03:45.18,Cap,,0,0,0,,IN THOSE SAME NINE
Dialogue: 0,0:03:45.18,0:03:45.91,Cap,,0,0,0,,SEASONS,
Dialogue: 0,0:03:45.91,0:03:46.95,Cap,,0,0,0,,ARSENAL DID NOT WIN
Dialogue: 0,0:03:46.95,0:03:48.14,Cap,,0,0,0,,THE LEAGUE ONCE.
Dialogue: 0,0:03:48.14,0:03:49.22,Cap,,0,0,0,,AND BY DECEMBER TWENTY
Dialogue: 0,0:03:49.22,0:03:50.30,Cap,,0,0,0,,SEVENTEEN,
Dialogue: 0,0:03:50.30,0:03:51.18,Cap,,0,0,0,,WENGER HAD A LINE
Dialogue: 0,0:03:51.18,0:03:52.18,Cap,,0,0,0,,FOR THE DIFFERENCE BETWEEN
Dialogue: 0,0:03:52.18,0:03:53.46,Cap,,0,0,0,,THE TWO CLUBS.
Dialogue: 0,0:03:53.68,0:03:57.10,Cap,,0,0,0,,WE HAD NO PETROL,
Dialogue: 0,0:03:57.10,0:03:57.89,Cap,,0,0,0,,BUT IDEAS.
Dialogue: 0,0:03:57.96,0:03:58.88,Cap,,0,0,0,,WE HAVE PETROL AND
Dialogue: 0,0:03:58.88,0:03:59.59,Cap,,0,0,0,,IDEAS,
Dialogue: 0,0:03:59.78,0:04:00.54,Cap,,0,0,0,,SO THAT MAKES IT
Dialogue: 0,0:04:00.54,0:04:01.50,Cap,,0,0,0,,EVEN MORE EFFICIENT,
Dialogue: 0,0:04:01.50,0:04:01.81,Cap,,0,0,0,,YOU
Dialogue: 0,0:04:02.08,0:04:03.04,Cap,,0,0,0,,A MONTH LATER,
Dialogue: 0,0:04:03.04,0:04:04.20,Cap,,0,0,0,,MANCHESTER UNITED SIGNED
Dialogue: 0,0:04:04.20,0:04:05.79,Cap,,0,0,0,,ALEXIS SÁNCHEZ FROM ARSENAL
Dialogue: 0,0:04:05.79,0:04:07.22,Cap,,0,0,0,,ON HUGE WAGES.
Dialogue: 0,0:04:07.29,0:04:08.28,Cap,,0,0,0,,WENGER WAS ASKED IF
Dialogue: 0,0:04:08.28,0:04:09.21,Cap,,0,0,0,,IT WORRIED HIM.
Dialogue: 0,0:04:09.35,0:04:10.24,Cap,,0,0,0,,LISTEN TO WHICH CLUB
Dialogue: 0,0:04:10.24,0:04:11.66,Cap,,0,0,0,,HE CHOSE TO PRAISE.
Dialogue: 0,0:04:11.88,0:04:14.60,Cap,,0,0,0,,I RESPECT MAN UNITED
Dialogue: 0,0:04:14.60,0:04:16.34,Cap,,0,0,0,,BECAUSE THEY GENERATE THE
Dialogue: 0,0:04:16.34,0:04:18.02,Cap,,0,0,0,,MONEY THEY PAY TO
Dialogue: 0,0:04:18.02,0:04:20.06,Cap,,0,0,0,,THE PLAYERS WITH THEIR
Dialogue: 0,0:04:20.06,0:04:21.15,Cap,,0,0,0,,OWN RESOURCES.
Dialogue: 0,0:04:21.26,0:04:21.78,Cap,,0,0,0,,SO YOU HAVE TO
Dialogue: 0,0:04:21.78,0:04:23.42,Cap,,0,0,0,,RESPECT THAT AND HE
Dialogue: 0,0:04:23.42,0:04:24.89,Cap,,0,0,0,,PRAISED ONE MANCHESTER CLUB
Dialogue: 0,0:04:24.89,0:04:25.85,Cap,,0,0,0,,FOR PAYING ITS PLAYERS
Dialogue: 0,0:04:25.85,0:04:27.28,Cap,,0,0,0,,WITH ITS OWN RESOURCES.
Dialogue: 0,0:04:27.28,0:04:28.11,Cap,,0,0,0,,HE DID NOT SAY
Dialogue: 0,0:04:28.11,0:04:28.85,Cap,,0,0,0,,THAT ABOUT THE OTHER
Dialogue: 0,0:04:28.85,0:04:29.56,Cap,,0,0,0,,ONE.
Dialogue: 0,0:04:29.66,0:04:31.46,Cap,,0,0,0,,IN MAY TWENTY EIGHTEEN,
Dialogue: 0,0:04:31.46,0:04:33.04,Cap,,0,0,0,,WENGER LEFT ARSENAL.
Dialogue: 0,0:04:33.39,0:04:34.37,Cap,,0,0,0,,SIX MONTHS LATER,
Dialogue: 0,0:04:34.37,0:04:35.70,Cap,,0,0,0,,THE GERMAN MAGAZINE DER
Dialogue: 0,0:04:35.70,0:04:37.38,Cap,,0,0,0,,SPIEGEL PUBLISHED LEAKED
Dialogue: 0,0:04:37.38,0:04:39.10,Cap,,0,0,0,,EMAILS FROM INSIDE MANCHESTER
Dialogue: 0,0:04:39.10,0:04:39.74,Cap,,0,0,0,,CITY,
Dialogue: 0,0:04:39.74,0:04:41.25,Cap,,0,0,0,,SUGGESTING THAT MONEY PRESENTED
Dialogue: 0,0:04:41.25,0:04:42.66,Cap,,0,0,0,,AS SPONSORSHIP HAD COME
Dialogue: 0,0:04:42.66,0:04:43.73,Cap,,0,0,0,,FROM THE OWNER.
Dialogue: 0,0:04:44.29,0:04:46.09,Cap,,0,0,0,,IN FEBRUARY TWENTY TWENTY,
Dialogue: 0,0:04:46.09,0:04:47.48,Cap,,0,0,0,,UEFA BANNED CITY FROM
Dialogue: 0,0:04:47.48,0:04:48.47,Cap,,0,0,0,,THE CHAMPIONS LEAGUE FOR
Dialogue: 0,0:04:48.47,0:04:49.58,Cap,,0,0,0,,TWO SEASONS.
Dialogue: 0,0:04:49.66,0:04:50.78,Cap,,0,0,0,,WENGER WAS ASKED ABOUT
Dialogue: 0,0:04:50.78,0:04:51.46,Cap,,0,0,0,,IT.
Dialogue: 0,0:04:51.68,0:04:53.94,Cap,,0,0,0,,SPORT IS BASICALLY TO
Dialogue: 0,0:04:53.94,0:04:55.56,Cap,,0,0,0,,WIN BY RESPECTING THE
Dialogue: 0,0:04:55.56,0:04:56.05,Cap,,0,0,0,,RULES.
Dialogue: 0,0:04:56.90,0:04:57.62,Cap,,0,0,0,,THAT'S WHAT IT IS
Dialogue: 0,0:04:57.62,0:04:58.02,Cap,,0,0,0,,ABOUT.
Dialogue: 0,0:04:58.02,0:04:58.92,Cap,,0,0,0,,WE CELEBRATE ALL THE
Dialogue: 0,0:04:58.92,0:05:00.47,Cap,,0,0,0,,BEST IN EVERY SPORT,
Dialogue: 0,0:05:00.66,0:05:01.74,Cap,,0,0,0,,BUT WE WANT TO
Dialogue: 0,0:05:01.74,0:05:02.56,Cap,,0,0,0,,KNOW THAT THEY RESPECT
Dialogue: 0,0:05:02.56,0:05:03.25,Cap,,0,0,0,,THE RULES.
Dialogue: 0,0:05:03.62,0:05:04.82,Cap,,0,0,0,,IF THERE'S NO RESPECT
Dialogue: 0,0:05:04.82,0:05:05.71,Cap,,0,0,0,,FOR THE RULES,
Dialogue: 0,0:05:05.74,0:05:07.60,Cap,,0,0,0,,IT'S NOT REAL SPORT.
Dialogue: 0,0:05:07.60,0:05:08.11,Cap,,0,0,0,,SO
Dialogue: 0,0:05:08.42,0:05:09.70,Cap,,0,0,0,,PEOPLE WHO DON'T RESPECT
Dialogue: 0,0:05:09.70,0:05:11.20,Cap,,0,0,0,,THEM AND ARE CAUGHT
Dialogue: 0,0:05:11.20,0:05:13.60,Cap,,0,0,0,,BY TRYING TO GET
Dialogue: 0,0:05:13.60,0:05:15.42,Cap,,0,0,0,,AROUND THE RULES IN
Dialogue: 0,0:05:15.42,0:05:16.50,Cap,,0,0,0,,MORE OR LESS LEGAL
Dialogue: 0,0:05:16.50,0:05:17.56,Cap,,0,0,0,,WAYS HAVE TO BE
Dialogue: 0,0:05:17.56,0:05:20.60,Cap,,0,0,0,,PUNISHED AND IF IT'S
Dialogue: 0,0:05:20.60,0:05:22.64,Cap,,0,0,0,,PROVEN THAT THIS HAS
Dialogue: 0,0:05:22.64,0:05:23.76,Cap,,0,0,0,,BEEN DONE ON PURPOSE
Dialogue: 0,0:05:23.76,0:05:26.06,Cap,,0,0,0,,YOU CANNOT LET THAT
Dialogue: 0,0:05:26.06,0:05:27.01,Cap,,0,0,0,,UNPUNISHED.
Dialogue: 0,0:05:27.46,0:05:28.80,Cap,,0,0,0,,FIVE MONTHS LATER,
Dialogue: 0,0:05:28.80,0:05:29.99,Cap,,0,0,0,,IT WAS ALL GONE.
Dialogue: 0,0:05:30.43,0:05:31.46,Cap,,0,0,0,,THE COURT OF ARBITRATION
Dialogue: 0,0:05:31.46,0:05:32.84,Cap,,0,0,0,,FOR SPORT OVERTURNED THE
Dialogue: 0,0:05:32.84,0:05:33.55,Cap,,0,0,0,,BAN.
Dialogue: 0,0:05:33.63,0:05:34.68,Cap,,0,0,0,,SOME OF THE ALLEGATIONS,
Dialogue: 0,0:05:34.68,0:05:35.03,Cap,,0,0,0,,IT SAID,
Dialogue: 0,0:05:35.03,0:05:36.30,Cap,,0,0,0,,WERE NOT ESTABLISHED,
Dialogue: 0,0:05:36.30,0:05:37.75,Cap,,0,0,0,,OTHERS WERE TIME-BARRED.
Dialogue: 0,0:05:37.89,0:05:38.82,Cap,,0,0,0,,CITY PAID A FINE
Dialogue: 0,0:05:38.82,0:05:40.07,Cap,,0,0,0,,FOR NOT COOPERATING,
Dialogue: 0,0:05:40.07,0:05:41.23,Cap,,0,0,0,,AND KEPT PLAYING IN
Dialogue: 0,0:05:41.23,0:05:41.97,Cap,,0,0,0,,EUROPE.
Dialogue: 0,0:05:42.32,0:05:43.46,Cap,,0,0,0,,JÜRGEN KLOPP WAS NOT
Dialogue: 0,0:05:43.46,0:05:44.52,Cap,,0,0,0,,IMPRESSED.
Dialogue: 0,0:05:57.38,0:05:58.93,Cap,,0,0,0,,PEP GUARDIOLA WANTED SOMETHING
Dialogue: 0,0:05:58.93,0:05:59.82,Cap,,0,0,0,,ELSE.
Dialogue: 0,0:05:60.00,0:06:03.16,Cap,,0,0,0,,INCREDIBLY HAPPY FOR THE
Dialogue: 0,0:06:03.16,0:06:07.24,Cap,,0,0,0,,DECISION AND SHOW THAT
Dialogue: 0,0:06:07.24,0:06:08.02,Cap,,0,0,0,,ALL THE PEOPLE SAID
Dialogue: 0,0:06:08.02,0:06:09.02,Cap,,0,0,0,,ABOUT THE CLUB IT
Dialogue: 0,0:06:09.02,0:06:10.21,Cap,,0,0,0,,WAS NOT TRUE.
Dialogue: 0,0:06:10.78,0:06:13.88,Cap,,0,0,0,,THE PEOPLE SAY THAT
Dialogue: 0,0:06:13.88,0:06:14.70,Cap,,0,0,0,,WE'RE CHEATING,
Dialogue: 0,0:06:14.70,0:06:15.29,Cap,,0,0,0,,WE'RE LYING,
Dialogue: 0,0:06:15.74,0:06:16.57,Cap,,0,0,0,,THE PEOPLE SAID THEY
Dialogue: 0,0:06:16.57,0:06:17.40,Cap,,0,0,0,,WERE CHEATING.
Dialogue: 0,0:06:17.54,0:06:19.03,Cap,,0,0,0,,IN FEBRUARY TWENTY TWENTY-THREE,
Dialogue: 0,0:06:19.03,0:06:19.95,Cap,,0,0,0,,THE PREMIER LEAGUE BROUGHT
Dialogue: 0,0:06:19.95,0:06:21.06,Cap,,0,0,0,,ITS OWN CASE.
Dialogue: 0,0:06:21.06,0:06:21.95,Cap,,0,0,0,,A HUNDRED AND FIFTEEN
Dialogue: 0,0:06:21.95,0:06:22.71,Cap,,0,0,0,,CHARGES.
Dialogue: 0,0:06:22.71,0:06:23.32,Cap,,0,0,0,,AND THREE AND A
Dialogue: 0,0:06:23.32,0:06:24.34,Cap,,0,0,0,,HALF YEARS LATER,
Dialogue: 0,0:06:24.34,0:06:25.49,Cap,,0,0,0,,THE COMMISSION FOUND CITY
Dialogue: 0,0:06:25.49,0:06:26.83,Cap,,0,0,0,,GUILTY ON ALMOST ALL
Dialogue: 0,0:06:26.83,0:06:27.53,Cap,,0,0,0,,OF THEM.
Dialogue: 0,0:06:27.66,0:06:29.13,Cap,,0,0,0,,SHAM CONTRACTS WITH COMMERCIAL
Dialogue: 0,0:06:29.13,0:06:30.03,Cap,,0,0,0,,PARTNERS.
Dialogue: 0,0:06:30.03,0:06:31.49,Cap,,0,0,0,,REVENUES INFLATED AND COSTS
Dialogue: 0,0:06:31.49,0:06:32.62,Cap,,0,0,0,,REDUCED BY MORE THAN
Dialogue: 0,0:06:32.62,0:06:34.28,Cap,,0,0,0,,NINE HUNDRED MILLION POUNDS.
Dialogue: 0,0:06:34.54,0:06:35.00,Cap,,0,0,0,,AND,
Dialogue: 0,0:06:35.00,0:06:36.24,Cap,,0,0,0,,THE COMMISSION FOUND,
Dialogue: 0,0:06:36.24,0:06:37.53,Cap,,0,0,0,,CONCERTED EFFORTS TO STOP
Dialogue: 0,0:06:37.53,0:06:38.94,Cap,,0,0,0,,AND FRUSTRATE THE INVESTIGATION
Dialogue: 0,0:06:38.94,0:06:39.95,Cap,,0,0,0,,ITSELF.
Dialogue: 0,0:06:46.85,0:06:47.42,Cap,,0,0,0,,NOW,
Dialogue: 0,0:06:47.42,0:06:48.29,Cap,,0,0,0,,TO BE FAIR,
Dialogue: 0,0:06:48.29,0:06:49.74,Cap,,0,0,0,,THIS IS NOT FINISHED.
Dialogue: 0,0:06:49.74,0:06:51.18,Cap,,0,0,0,,CITY DENY ALL WRONGDOING.
Dialogue: 0,0:06:51.18,0:06:52.26,Cap,,0,0,0,,THEY HAVE ALREADY LODGED
Dialogue: 0,0:06:52.26,0:06:52.99,Cap,,0,0,0,,AN APPEAL.
Dialogue: 0,0:06:52.99,0:06:54.00,Cap,,0,0,0,,THE PUNISHMENT HAS NOT
Dialogue: 0,0:06:54.00,0:06:55.08,Cap,,0,0,0,,EVEN BEEN DECIDED,
Dialogue: 0,0:06:55.08,0:06:56.23,Cap,,0,0,0,,AND A FINAL OUTCOME
Dialogue: 0,0:06:56.23,0:06:57.09,Cap,,0,0,0,,MAY NOT COME UNTIL
Dialogue: 0,0:06:57.09,0:06:58.30,Cap,,0,0,0,,TWENTY TWENTY-SEVEN.
Dialogue: 0,0:06:58.38,0:06:59.48,Cap,,0,0,0,,BUT WHATEVER HAPPENS TO
Dialogue: 0,0:06:59.48,0:07:00.30,Cap,,0,0,0,,CITY NOW,
Dialogue: 0,0:07:00.30,0:07:01.41,Cap,,0,0,0,,IT CANNOT GIVE ANYTHING
Dialogue: 0,0:07:01.41,0:07:02.03,Cap,,0,0,0,,BACK TO THE MAN
Dialogue: 0,0:07:02.03,0:07:03.00,Cap,,0,0,0,,WHO SPENT THOSE NINE
Dialogue: 0,0:07:03.00,0:07:03.88,Cap,,0,0,0,,SEASONS ON THE OTHER
Dialogue: 0,0:07:03.88,0:07:04.79,Cap,,0,0,0,,SIDE.
Dialogue: 0,0:07:04.89,0:07:06.32,Cap,,0,0,0,,HE LOST HIS PLAYERS.
Dialogue: 0,0:07:06.32,0:07:07.26,Cap,,0,0,0,,HE LOST THE TITLE
Dialogue: 0,0:07:07.26,0:07:07.97,Cap,,0,0,0,,RACES.
Dialogue: 0,0:07:07.97,0:07:08.57,Cap,,0,0,0,,FOR YEARS,
Dialogue: 0,0:07:08.57,0:07:09.16,Cap,,0,0,0,,HE WAS TOLD THAT
Dialogue: 0,0:07:09.16,0:07:10.44,Cap,,0,0,0,,TALKING ABOUT MONEY WAS
Dialogue: 0,0:07:10.44,0:07:11.71,Cap,,0,0,0,,AN EXCUSE FOR LOSING.
Dialogue: 0,0:07:11.71,0:07:12.49,Cap,,0,0,0,,AND ALL ALONG,
Dialogue: 0,0:07:12.49,0:07:13.31,Cap,,0,0,0,,HE KEPT SAYING THE
Dialogue: 0,0:07:13.31,0:07:13.93,Cap,,0,0,0,,SAME THING.
Dialogue: 0,0:07:13.93,0:07:14.58,Cap,,0,0,0,,HE SAID IT IN
Dialogue: 0,0:07:14.58,0:07:15.81,Cap,,0,0,0,,NINETEEN NINETY-SIX.
Dialogue: 0,0:07:15.81,0:07:16.34,Cap,,0,0,0,,HE SAID IT IN
Dialogue: 0,0:07:16.34,0:07:17.40,Cap,,0,0,0,,TWENTY ELEVEN.
Dialogue: 0,0:07:17.40,0:07:18.19,Cap,,0,0,0,,HE SAID IT AGAIN
Dialogue: 0,0:07:18.19,0:07:19.49,Cap,,0,0,0,,IN TWENTY TWENTY.
Dialogue: 0,0:07:19.71,0:07:20.91,Cap,,0,0,0,,IF THERE'S NO RESPECT
Dialogue: 0,0:07:20.91,0:07:21.80,Cap,,0,0,0,,FOR THE RULES,
Dialogue: 0,0:07:21.83,0:07:23.69,Cap,,0,0,0,,IT'S NOT REAL SPORT.
Dialogue: 0,0:07:23.69,0:07:25.58,Cap,,0,0,0,,SO ARSÈNE WENGER TRIED
Dialogue: 0,0:07:25.58,0:07:26.39,Cap,,0,0,0,,TO WARN US.
Dialogue: 0,0:07:26.39,0:07:27.99,Cap,,0,0,0,,ALMOST NOBODY LISTENED.
