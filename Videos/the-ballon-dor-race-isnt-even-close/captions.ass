Dialogue: 0,0:00:00.25,0:00:01.54,Cap,,0,0,0,,SIXTY-ONE GOALS.
Dialogue: 0,0:00:01.54,0:00:02.65,Cap,,0,0,0,,A LEAGUE TITLE.
Dialogue: 0,0:00:02.65,0:00:04.08,Cap,,0,0,0,,A CUP FINAL HAT-TRICK.
Dialogue: 0,0:00:04.08,0:00:05.70,Cap,,0,0,0,,THE EUROPEAN GOLDEN SHOE.
Dialogue: 0,0:00:05.73,0:00:06.62,Cap,,0,0,0,,THAT IS HARRY KANE'S
Dialogue: 0,0:00:06.62,0:00:07.27,Cap,,0,0,0,,SEASON.
Dialogue: 0,0:00:07.27,0:00:08.19,Cap,,0,0,0,,NOW HERE IS LAMINE
Dialogue: 0,0:00:08.19,0:00:09.61,Cap,,0,0,0,,YAMAL'S WORLD CUP.
Dialogue: 0,0:00:09.64,0:00:10.48,Cap,,0,0,0,,ONE GOAL.
Dialogue: 0,0:00:10.48,0:00:11.65,Cap,,0,0,0,,ZERO ASSISTS.
Dialogue: 0,0:00:11.65,0:00:12.68,Cap,,0,0,0,,EIGHT MATCHES.
Dialogue: 0,0:00:12.68,0:00:13.68,Cap,,0,0,0,,AND THE BOOKMAKERS HAVE
Dialogue: 0,0:00:13.68,0:00:14.65,Cap,,0,0,0,,LOOKED AT THOSE NUMBERS
Dialogue: 0,0:00:14.65,0:00:15.88,Cap,,0,0,0,,AND MADE THEIR CHOICE.
Dialogue: 0,0:00:15.88,0:00:16.64,Cap,,0,0,0,,HARRY KANE IS THE
Dialogue: 0,0:00:16.64,0:00:17.35,Cap,,0,0,0,,FAVOURITE TO WIN THE
Dialogue: 0,0:00:17.35,0:00:18.19,Cap,,0,0,0,,BALLON D'OR.
Dialogue: 0,0:00:18.19,0:00:18.77,Cap,,0,0,0,,I THINK THEY ARE
Dialogue: 0,0:00:18.77,0:00:19.38,Cap,,0,0,0,,WRONG.
Dialogue: 0,0:00:19.38,0:00:20.07,Cap,,0,0,0,,AND HONESTLY?
Dialogue: 0,0:00:20.07,0:00:20.65,Cap,,0,0,0,,I DON'T THINK IT'S
Dialogue: 0,0:00:20.65,0:00:21.72,Cap,,0,0,0,,EVEN CLOSE.
Dialogue: 0,0:00:25.37,0:00:26.78,Cap,,0,0,0,,START WITH WHAT THIS
Dialogue: 0,0:00:26.78,0:00:28.13,Cap,,0,0,0,,AWARD ACTUALLY IS.
Dialogue: 0,0:00:28.21,0:00:28.93,Cap,,0,0,0,,IT IS NOT THE
Dialogue: 0,0:00:28.93,0:00:29.65,Cap,,0,0,0,,GOLDEN BOOT.
Dialogue: 0,0:00:29.65,0:00:30.16,Cap,,0,0,0,,IT IS NOT A
Dialogue: 0,0:00:30.16,0:00:31.09,Cap,,0,0,0,,SPREADSHEET.
Dialogue: 0,0:00:31.28,0:00:32.53,Cap,,0,0,0,,FRANCE FOOTBALL GIVES ITS
Dialogue: 0,0:00:32.53,0:00:33.90,Cap,,0,0,0,,JURY THREE CRITERIA.
Dialogue: 0,0:00:33.90,0:00:35.24,Cap,,0,0,0,,INDIVIDUAL PERFORMANCE.
Dialogue: 0,0:00:35.24,0:00:36.44,Cap,,0,0,0,,COLLECTIVE PERFORMANCE AND
Dialogue: 0,0:00:36.44,0:00:37.40,Cap,,0,0,0,,TITLES.
Dialogue: 0,0:00:37.96,0:00:39.33,Cap,,0,0,0,,AND CLASS.
Dialogue: 0,0:00:39.90,0:00:41.05,Cap,,0,0,0,,A SEASON IS JUDGED
Dialogue: 0,0:00:41.05,0:00:43.53,Cap,,0,0,0,,FROM AUGUST TWENTY TWENTY-FIVE
Dialogue: 0,0:00:43.66,0:00:44.58,Cap,,0,0,0,,TO THE WORLD CUP
Dialogue: 0,0:00:44.58,0:00:46.10,Cap,,0,0,0,,FINAL IN JULY.
Dialogue: 0,0:00:46.24,0:00:47.04,Cap,,0,0,0,,SO THE QUESTION IS
Dialogue: 0,0:00:47.04,0:00:47.97,Cap,,0,0,0,,NOT WHO SCORED THE
Dialogue: 0,0:00:47.97,0:00:48.79,Cap,,0,0,0,,MOST.
Dialogue: 0,0:00:48.86,0:00:49.72,Cap,,0,0,0,,IT'S THIS.
Dialogue: 0,0:00:49.72,0:00:50.53,Cap,,0,0,0,,WHO WAS THE BEST
Dialogue: 0,0:00:50.53,0:00:51.57,Cap,,0,0,0,,PLAYER IN THE BIGGEST
Dialogue: 0,0:00:51.57,0:00:52.75,Cap,,0,0,0,,MOMENTS OF THE SEASON?
Dialogue: 0,0:00:52.75,0:00:53.88,Cap,,0,0,0,,ASK THAT QUESTION,
Dialogue: 0,0:00:53.88,0:00:55.53,Cap,,0,0,0,,AND THE ANSWER CHANGES.
Dialogue: 0,0:00:55.98,0:00:57.04,Cap,,0,0,0,,EXHIBIT A.
Dialogue: 0,0:00:57.04,0:00:58.01,Cap,,0,0,0,,LA LIGA.
Dialogue: 0,0:00:58.08,0:00:59.37,Cap,,0,0,0,,SIXTEEN GOALS.
Dialogue: 0,0:00:59.37,0:01:00.83,Cap,,0,0,0,,ELEVEN ASSISTS.
Dialogue: 0,0:01:00.83,0:01:02.08,Cap,,0,0,0,,MORE ASSISTS THAN ANYONE
Dialogue: 0,0:01:02.08,0:01:03.10,Cap,,0,0,0,,IN THE DIVISION.
Dialogue: 0,0:01:03.24,0:01:03.92,Cap,,0,0,0,,A SHARE OF THE
Dialogue: 0,0:01:03.92,0:01:05.16,Cap,,0,0,0,,ZARRA TROPHY AS THE
Dialogue: 0,0:01:05.16,0:01:07.04,Cap,,0,0,0,,TOP SPANISH SCORER.
Dialogue: 0,0:01:07.11,0:01:09.09,Cap,,0,0,0,,HIS FIRST SENIOR HAT-TRICK,
Dialogue: 0,0:01:09.09,0:01:10.33,Cap,,0,0,0,,AGAINST VILLARREAL,
Dialogue: 0,0:01:10.33,0:01:11.51,Cap,,0,0,0,,IN FEBRUARY.
Dialogue: 0,0:01:11.54,0:01:12.13,Cap,,0,0,0,,AND AT THE END
Dialogue: 0,0:01:12.13,0:01:12.59,Cap,,0,0,0,,OF IT,
Dialogue: 0,0:01:12.59,0:01:14.10,Cap,,0,0,0,,BARCELONA WERE CHAMPIONS,
Dialogue: 0,0:01:14.10,0:01:15.64,Cap,,0,0,0,,AND LAMINE WAS NAMED
Dialogue: 0,0:01:15.64,0:01:16.59,Cap,,0,0,0,,LA LIGA'S PLAYER OF
Dialogue: 0,0:01:16.59,0:01:17.33,Cap,,0,0,0,,THE SEASON.
Dialogue: 0,0:01:17.33,0:01:18.44,Cap,,0,0,0,,AT EIGHTEEN.
Dialogue: 0,0:01:18.47,0:01:19.49,Cap,,0,0,0,,BUT THE NUMBERS STILL
Dialogue: 0,0:01:19.49,0:01:20.65,Cap,,0,0,0,,UNDERSELL HIM.
Dialogue: 0,0:01:20.78,0:01:21.79,Cap,,0,0,0,,BECAUSE EVERY WEEK,
Dialogue: 0,0:01:21.79,0:01:23.09,Cap,,0,0,0,,THE OPPONENT'S PLAN STARTS
Dialogue: 0,0:01:23.09,0:01:24.37,Cap,,0,0,0,,WITH ONE QUESTION.
Dialogue: 0,0:01:24.37,0:01:25.25,Cap,,0,0,0,,HOW DO WE STOP
Dialogue: 0,0:01:25.25,0:01:25.81,Cap,,0,0,0,,HIM?
Dialogue: 0,0:01:25.81,0:01:26.74,Cap,,0,0,0,,DOUBLE HIM,
Dialogue: 0,0:01:26.74,0:01:28.27,Cap,,0,0,0,,AND RAPHINHA IS FREE.
Dialogue: 0,0:01:28.35,0:01:29.15,Cap,,0,0,0,,SIT OFF HIM,
Dialogue: 0,0:01:29.15,0:01:29.93,Cap,,0,0,0,,AND HE CURLS IT
Dialogue: 0,0:01:29.93,0:01:31.12,Cap,,0,0,0,,INTO THE FAR CORNER.
Dialogue: 0,0:01:31.12,0:01:31.70,Cap,,0,0,0,,PRESS HIM,
Dialogue: 0,0:01:31.70,0:01:32.70,Cap,,0,0,0,,AND HE PLAYS THROUGH
Dialogue: 0,0:01:32.70,0:01:33.20,Cap,,0,0,0,,YOU.
Dialogue: 0,0:01:33.27,0:01:34.69,Cap,,0,0,0,,KANE FINISHES MOVES.
Dialogue: 0,0:01:34.69,0:01:35.84,Cap,,0,0,0,,YAMAL DECIDES WHERE THE
Dialogue: 0,0:01:35.84,0:01:37.01,Cap,,0,0,0,,MOVE GOES.
Dialogue: 0,0:01:37.45,0:01:38.50,Cap,,0,0,0,,THERE'S A WORD ANALYSTS
Dialogue: 0,0:01:38.50,0:01:39.64,Cap,,0,0,0,,USE FOR THIS.
Dialogue: 0,0:01:39.78,0:01:40.82,Cap,,0,0,0,,GRAVITY.
Dialogue: 0,0:01:40.95,0:01:42.39,Cap,,0,0,0,,SOME PLAYERS PULL DEFENDERS
Dialogue: 0,0:01:42.39,0:01:43.62,Cap,,0,0,0,,TOWARDS THEM JUST BY
Dialogue: 0,0:01:43.62,0:01:45.15,Cap,,0,0,0,,STANDING ON THE TOUCHLINE.
Dialogue: 0,0:01:45.28,0:01:46.13,Cap,,0,0,0,,LAMINE MIGHT HAVE THE
Dialogue: 0,0:01:46.13,0:01:47.26,Cap,,0,0,0,,STRONGEST PULL IN WORLD
Dialogue: 0,0:01:47.26,0:01:48.22,Cap,,0,0,0,,FOOTBALL.
Dialogue: 0,0:01:48.22,0:01:49.64,Cap,,0,0,0,,WATCH THE FULL-BACK.
Dialogue: 0,0:01:49.64,0:01:50.67,Cap,,0,0,0,,THEN WATCH THE WINGER
Dialogue: 0,0:01:50.67,0:01:51.89,Cap,,0,0,0,,TUCK IN TO HELP.
Dialogue: 0,0:01:51.97,0:01:53.14,Cap,,0,0,0,,THEN WATCH THE MIDFIELDER
Dialogue: 0,0:01:53.14,0:01:54.22,Cap,,0,0,0,,DRIFT ACROSS,
Dialogue: 0,0:01:54.22,0:01:55.28,Cap,,0,0,0,,JUST IN CASE.
Dialogue: 0,0:01:55.28,0:01:56.16,Cap,,0,0,0,,THREE PLAYERS,
Dialogue: 0,0:01:56.16,0:01:57.69,Cap,,0,0,0,,ALL THINKING ABOUT ONE
Dialogue: 0,0:01:57.69,0:01:58.54,Cap,,0,0,0,,TEENAGER.
Dialogue: 0,0:01:58.54,0:01:59.61,Cap,,0,0,0,,WHICH MEANS SOMEWHERE ELSE
Dialogue: 0,0:01:59.61,0:02:00.49,Cap,,0,0,0,,ON THE PITCH,
Dialogue: 0,0:02:00.49,0:02:01.51,Cap,,0,0,0,,SOMEONE IN A BARCELONA
Dialogue: 0,0:02:01.51,0:02:02.79,Cap,,0,0,0,,SHIRT HAS TIME.
Dialogue: 0,0:02:03.05,0:02:03.60,Cap,,0,0,0,,THAT IS WHERE A
Dialogue: 0,0:02:03.60,0:02:04.62,Cap,,0,0,0,,LOT OF THOSE BARCELONA
Dialogue: 0,0:02:04.62,0:02:06.16,Cap,,0,0,0,,GOALS REALLY STARTED.
Dialogue: 0,0:02:06.35,0:02:07.27,Cap,,0,0,0,,IT DOESN'T SHOW UP
Dialogue: 0,0:02:07.27,0:02:08.36,Cap,,0,0,0,,IN HIS GOAL COLUMN.
Dialogue: 0,0:02:08.36,0:02:08.98,Cap,,0,0,0,,IT SHOWS UP IN
Dialogue: 0,0:02:08.98,0:02:10.49,Cap,,0,0,0,,EVERYBODY ELSE'S.
Dialogue: 0,0:02:11.44,0:02:12.29,Cap,,0,0,0,,EXHIBIT B.
Dialogue: 0,0:02:12.29,0:02:13.32,Cap,,0,0,0,,THE WORLD CUP.
Dialogue: 0,0:02:13.45,0:02:13.90,Cap,,0,0,0,,AND YES,
Dialogue: 0,0:02:13.90,0:02:14.81,Cap,,0,0,0,,LET'S DEAL WITH IT.
Dialogue: 0,0:02:14.81,0:02:15.33,Cap,,0,0,0,,ONE GOAL,
Dialogue: 0,0:02:15.33,0:02:16.58,Cap,,0,0,0,,AGAINST SAUDI ARABIA.
Dialogue: 0,0:02:16.58,0:02:17.76,Cap,,0,0,0,,THEN FOUR STRAIGHT GAMES
Dialogue: 0,0:02:17.76,0:02:18.58,Cap,,0,0,0,,WITHOUT A GOAL OR
Dialogue: 0,0:02:18.58,0:02:19.45,Cap,,0,0,0,,AN ASSIST.
Dialogue: 0,0:02:19.45,0:02:20.53,Cap,,0,0,0,,PEOPLE WERE ASKING WHETHER
Dialogue: 0,0:02:20.53,0:02:21.32,Cap,,0,0,0,,HE SHOULD EVEN START
Dialogue: 0,0:02:21.32,0:02:22.45,Cap,,0,0,0,,THE SEMI-FINAL.
Dialogue: 0,0:02:22.45,0:02:23.83,Cap,,0,0,0,,BUT WATCH THE QUARTER-FINAL
Dialogue: 0,0:02:23.83,0:02:25.19,Cap,,0,0,0,,AGAINST BELGIUM.
Dialogue: 0,0:02:25.27,0:02:26.11,Cap,,0,0,0,,NO GOAL.
Dialogue: 0,0:02:26.11,0:02:27.20,Cap,,0,0,0,,NO ASSIST.
Dialogue: 0,0:02:27.23,0:02:27.96,Cap,,0,0,0,,AND HE WAS STILL
Dialogue: 0,0:02:27.96,0:02:28.83,Cap,,0,0,0,,NAMED PLAYER OF THE
Dialogue: 0,0:02:28.83,0:02:29.62,Cap,,0,0,0,,MATCH.
Dialogue: 0,0:02:29.69,0:02:31.11,Cap,,0,0,0,,BECAUSE BELGIUM SPENT NINETY
Dialogue: 0,0:02:31.11,0:02:32.49,Cap,,0,0,0,,MINUTES SHIFTING THEIR WHOLE
Dialogue: 0,0:02:32.49,0:02:33.99,Cap,,0,0,0,,DEFENCE TOWARDS ONE SIDE
Dialogue: 0,0:02:33.99,0:02:34.78,Cap,,0,0,0,,OF THE PITCH,
Dialogue: 0,0:02:34.78,0:02:36.01,Cap,,0,0,0,,AND SPAIN PLAYED THROUGH
Dialogue: 0,0:02:36.01,0:02:37.44,Cap,,0,0,0,,THE SPACE THAT LEFT.
Dialogue: 0,0:02:37.44,0:02:38.68,Cap,,0,0,0,,THEN FRANCE,
Dialogue: 0,0:02:38.68,0:02:39.69,Cap,,0,0,0,,TWO-NIL.
Dialogue: 0,0:02:39.69,0:02:40.87,Cap,,0,0,0,,THEN THE FINAL.
Dialogue: 0,0:02:40.94,0:02:42.07,Cap,,0,0,0,,SPAIN ONE,
Dialogue: 0,0:02:42.07,0:02:43.33,Cap,,0,0,0,,ARGENTINA NIL,
Dialogue: 0,0:02:43.33,0:02:44.72,Cap,,0,0,0,,AFTER EXTRA TIME.
Dialogue: 0,0:02:45.08,0:02:46.60,Cap,,0,0,0,,ARGENTINA MANAGED TWO SHOTS
Dialogue: 0,0:02:46.60,0:02:47.95,Cap,,0,0,0,,IN THE ENTIRE GAME.
Dialogue: 0,0:02:48.02,0:02:48.76,Cap,,0,0,0,,TWO.
Dialogue: 0,0:02:48.95,0:02:49.84,Cap,,0,0,0,,SPAIN DID NOT WIN
Dialogue: 0,0:02:49.84,0:02:51.04,Cap,,0,0,0,,THE WORLD CUP BECAUSE
Dialogue: 0,0:02:51.04,0:02:52.35,Cap,,0,0,0,,LAMINE SCORED.
Dialogue: 0,0:02:52.43,0:02:53.48,Cap,,0,0,0,,THEY WON IT BECAUSE
Dialogue: 0,0:02:53.48,0:02:54.38,Cap,,0,0,0,,NOBODY COULD LEAVE HIM
Dialogue: 0,0:02:54.38,0:02:55.35,Cap,,0,0,0,,ALONE.
Dialogue: 0,0:02:55.90,0:02:56.78,CapHi,,0,0,0,,IT WAS RAPHINHA WHO
Dialogue: 0,0:02:56.78,0:02:57.74,CapHi,,0,0,0,,HAD A DIFFICULT SEASON
Dialogue: 0,0:02:57.74,0:02:58.66,CapHi,,0,0,0,,BECAUSE HE WAS INJURED
Dialogue: 0,0:02:58.66,0:02:59.62,CapHi,,0,0,0,,A LOT MORE.
Dialogue: 0,0:02:59.62,0:03:01.18,CapHi,,0,0,0,,LAMINE YAMAL WAS ABSOLUTELY
Dialogue: 0,0:03:01.18,0:03:01.66,CapHi,,0,0,0,,MAGNIFICENT.
Dialogue: 0,0:03:01.66,0:03:02.30,CapHi,,0,0,0,,DIDN'T PLAY HIS BEST
Dialogue: 0,0:03:02.30,0:03:03.02,CapHi,,0,0,0,,AT THE WORLD CUP
Dialogue: 0,0:03:03.02,0:03:04.34,CapHi,,0,0,0,,BUT WHAT A PLAYER.
Dialogue: 0,0:03:04.69,0:03:05.36,Cap,,0,0,0,,NOW,
Dialogue: 0,0:03:05.36,0:03:06.58,Cap,,0,0,0,,HARRY KANE DESERVES REAL
Dialogue: 0,0:03:06.58,0:03:07.53,Cap,,0,0,0,,RESPECT HERE.
Dialogue: 0,0:03:07.53,0:03:09.14,Cap,,0,0,0,,THIRTY-SIX LEAGUE GOALS.
Dialogue: 0,0:03:09.14,0:03:10.41,Cap,,0,0,0,,FOURTEEN IN THE CHAMPIONS
Dialogue: 0,0:03:10.41,0:03:10.94,Cap,,0,0,0,,LEAGUE.
Dialogue: 0,0:03:10.94,0:03:11.78,Cap,,0,0,0,,A HAT-TRICK IN THE
Dialogue: 0,0:03:11.78,0:03:12.58,Cap,,0,0,0,,CUP FINAL.
Dialogue: 0,0:03:12.58,0:03:13.52,Cap,,0,0,0,,THAT IS AN OUTSTANDING
Dialogue: 0,0:03:13.52,0:03:13.87,Cap,,0,0,0,,SEASON,
Dialogue: 0,0:03:13.87,0:03:14.48,Cap,,0,0,0,,AND IF THIS WERE
Dialogue: 0,0:03:14.48,0:03:15.39,Cap,,0,0,0,,THE GOLDEN BOOT,
Dialogue: 0,0:03:15.39,0:03:16.66,Cap,,0,0,0,,WE WOULD BE DONE.
Dialogue: 0,0:03:16.73,0:03:17.78,Cap,,0,0,0,,BUT LOOK AT WHERE
Dialogue: 0,0:03:17.78,0:03:18.59,Cap,,0,0,0,,IT ENDED.
Dialogue: 0,0:03:18.59,0:03:19.51,Cap,,0,0,0,,BAYERN WENT OUT OF
Dialogue: 0,0:03:19.51,0:03:20.47,Cap,,0,0,0,,THE CHAMPIONS LEAGUE IN
Dialogue: 0,0:03:20.47,0:03:21.73,Cap,,0,0,0,,THE SEMI-FINALS.
Dialogue: 0,0:03:22.18,0:03:23.62,Cap,,0,0,0,,ENGLAND LED ARGENTINA IN
Dialogue: 0,0:03:23.62,0:03:25.08,Cap,,0,0,0,,THE WORLD CUP SEMI-FINAL,
Dialogue: 0,0:03:25.08,0:03:26.63,Cap,,0,0,0,,AND LOST TWO-ONE.
Dialogue: 0,0:03:27.19,0:03:27.93,Cap,,0,0,0,,IN THE TWO GAMES
Dialogue: 0,0:03:27.93,0:03:28.72,Cap,,0,0,0,,THAT WOULD HAVE DEFINED
Dialogue: 0,0:03:28.72,0:03:29.50,Cap,,0,0,0,,HIS YEAR,
Dialogue: 0,0:03:29.50,0:03:30.67,Cap,,0,0,0,,KANE WENT HOME.
Dialogue: 0,0:03:31.37,0:03:32.47,Cap,,0,0,0,,YAMAL WENT TO THE
Dialogue: 0,0:03:32.47,0:03:33.25,Cap,,0,0,0,,FINAL.
Dialogue: 0,0:03:33.38,0:03:34.62,Cap,,0,0,0,,AND HE WON IT.
Dialogue: 0,0:03:35.57,0:03:36.77,Cap,,0,0,0,,WHAT ABOUT THE REST?
Dialogue: 0,0:03:36.77,0:03:38.01,Cap,,0,0,0,,KYLIAN MBAPPÉ WON THE
Dialogue: 0,0:03:38.01,0:03:39.01,Cap,,0,0,0,,WORLD CUP GOLDEN BOOT
Dialogue: 0,0:03:39.01,0:03:40.07,Cap,,0,0,0,,WITH TEN GOALS.
Dialogue: 0,0:03:40.07,0:03:40.95,Cap,,0,0,0,,BRILLIANT.
Dialogue: 0,0:03:40.98,0:03:41.87,Cap,,0,0,0,,BUT REAL MADRID WON
Dialogue: 0,0:03:41.87,0:03:42.27,Cap,,0,0,0,,NOTHING,
Dialogue: 0,0:03:42.27,0:03:43.06,Cap,,0,0,0,,AND FRANCE WENT OUT
Dialogue: 0,0:03:43.06,0:03:43.87,Cap,,0,0,0,,TO SPAIN.
Dialogue: 0,0:03:43.87,0:03:44.50,Cap,,0,0,0,,AND
Dialogue: 0,0:03:44.95,0:03:46.27,Cap,,0,0,0,,OUSMANE DEMBÉLÉ?
Dialogue: 0,0:03:46.27,0:03:47.61,Cap,,0,0,0,,HE ALREADY HAS ONE.
Dialogue: 0,0:03:47.61,0:03:48.94,Cap,,0,0,0,,PSG WON THE CHAMPIONS
Dialogue: 0,0:03:48.94,0:03:49.77,Cap,,0,0,0,,LEAGUE AGAIN,
Dialogue: 0,0:03:49.77,0:03:50.50,Cap,,0,0,0,,BUT THEY WERE ALREADY
Dialogue: 0,0:03:50.50,0:03:51.44,Cap,,0,0,0,,THE CHAMPIONS OF EUROPE
Dialogue: 0,0:03:51.44,0:03:51.97,Cap,,0,0,0,,LAST YEAR.
Dialogue: 0,0:03:51.97,0:03:52.98,Cap,,0,0,0,,NOBODY ELSE HAS LA
Dialogue: 0,0:03:52.98,0:03:53.37,Cap,,0,0,0,,LIGA,
Dialogue: 0,0:03:53.37,0:03:53.90,Cap,,0,0,0,,THE PLAYER OF THE
