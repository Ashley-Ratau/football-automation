Dialogue: 0,0:04:14.06,0:04:14.94,Cap,,0,0,0,,CAN DO WHAT THEY
Dialogue: 0,0:04:14.94,0:04:15.53,Cap,,0,0,0,,WANT,
Dialogue: 0,0:04:16.40,0:04:16.87,Cap,,0,0,0,,FINANCIALLY.
Dialogue: 0,0:04:17.66,0:04:18.84,Cap,,0,0,0,,IT'S LEGAL AND EVERYTHING
Dialogue: 0,0:04:18.84,0:04:19.26,Cap,,0,0,0,,IS FINE,
Dialogue: 0,0:04:19.26,0:04:19.84,Cap,,0,0,0,,BUT THEY CAN DO
Dialogue: 0,0:04:19.84,0:04:20.71,Cap,,0,0,0,,WHAT THEY WANT,
Dialogue: 0,0:04:21.16,0:04:22.54,Cap,,0,0,0,,NOTICE WHAT HE SAID.
Dialogue: 0,0:04:22.99,0:04:24.09,Cap,,0,0,0,,IT'S LEGAL AND EVERYTHING
Dialogue: 0,0:04:24.09,0:04:25.04,Cap,,0,0,0,,IS FINE.
Dialogue: 0,0:04:25.11,0:04:26.55,Cap,,0,0,0,,KLOPP NEVER ACCUSED CITY
Dialogue: 0,0:04:26.55,0:04:27.35,Cap,,0,0,0,,OF CHEATING.
Dialogue: 0,0:04:27.35,0:04:28.49,Cap,,0,0,0,,HE JUST KEPT SAYING
Dialogue: 0,0:04:28.49,0:04:29.26,Cap,,0,0,0,,THAT THE MONEY WAS
Dialogue: 0,0:04:29.26,0:04:30.10,Cap,,0,0,0,,DIFFERENT.
Dialogue: 0,0:04:30.54,0:04:31.66,Cap,,0,0,0,,FOUR MONTHS LATER,
Dialogue: 0,0:04:31.66,0:04:32.82,Cap,,0,0,0,,THE PREMIER LEAGUE CHARGED
Dialogue: 0,0:04:32.82,0:04:33.68,Cap,,0,0,0,,CITY WITH A HUNDRED
Dialogue: 0,0:04:33.68,0:04:35.35,Cap,,0,0,0,,AND FIFTEEN BREACHES OF
Dialogue: 0,0:04:35.35,0:04:36.37,Cap,,0,0,0,,ITS RULES.
Dialogue: 0,0:04:36.37,0:04:37.67,Cap,,0,0,0,,PEP GUARDIOLA CAME OUT
Dialogue: 0,0:04:37.67,0:04:38.60,Cap,,0,0,0,,FIGHTING.
Dialogue: 0,0:04:38.82,0:04:39.56,Cap,,0,0,0,,WE ARE ALREADY BEING
Dialogue: 0,0:04:39.56,0:04:40.11,Cap,,0,0,0,,CONDEMNED.
Dialogue: 0,0:04:41.36,0:04:41.42,Cap,,0,0,0,,SO,
Dialogue: 0,0:04:41.42,0:04:41.74,Cap,,0,0,0,,LIKE,
Dialogue: 0,0:04:41.74,0:04:43.54,Cap,,0,0,0,,IT'S HAPPENED RIGHT NOW,
Dialogue: 0,0:04:43.54,0:04:44.62,Cap,,0,0,0,,THESE WEEKS AFTER MONDAY,
Dialogue: 0,0:04:44.62,0:04:45.42,Cap,,0,0,0,,IT HAPPENED THE SAME
Dialogue: 0,0:04:45.42,0:04:46.08,Cap,,0,0,0,,WHAT HAPPENED IN THE
Dialogue: 0,0:04:46.08,0:04:46.59,Cap,,0,0,0,,UEFA.
Dialogue: 0,0:04:47.04,0:04:48.12,Cap,,0,0,0,,AND KLOPP,
Dialogue: 0,0:04:48.12,0:04:48.67,Cap,,0,0,0,,THE MAN WHO HAD
Dialogue: 0,0:04:48.67,0:04:49.64,Cap,,0,0,0,,COMPLAINED ABOUT CITY'S
Dialogue: 0,0:04:49.64,0:04:50.87,Cap,,0,0,0,,MONEY FOR YEARS?
Dialogue: 0,0:04:51.06,0:04:52.23,Cap,,0,0,0,,WHEN THE CHARGES LANDED,
Dialogue: 0,0:04:52.23,0:04:53.00,Cap,,0,0,0,,HE WAS ASKED ABOUT
Dialogue: 0,0:04:53.00,0:04:53.34,Cap,,0,0,0,,THEM.
Dialogue: 0,0:04:53.34,0:04:54.81,Cap,,0,0,0,,THIS WAS HIS ANSWER.
Dialogue: 0,0:04:55.03,0:04:55.75,Cap,,0,0,0,,I'VE ABSOLUTELY NOTHING
Dialogue: 0,0:04:55.75,0:04:56.92,Cap,,0,0,0,,TO SAY ABOUT IT.
Dialogue: 0,0:04:57.37,0:04:58.74,Cap,,0,0,0,,KLOPP LEFT LIVERPOOL IN
Dialogue: 0,0:04:58.74,0:05:00.03,Cap,,0,0,0,,TWENTY TWENTY-FOUR.
Dialogue: 0,0:05:00.23,0:05:01.79,Cap,,0,0,0,,IN JANUARY TWENTY TWENTY-FIVE,
Dialogue: 0,0:05:01.79,0:05:02.56,Cap,,0,0,0,,HE WAS ASKED WHAT
Dialogue: 0,0:05:02.56,0:05:03.26,Cap,,0,0,0,,HE WOULD DO IF
Dialogue: 0,0:05:03.26,0:05:04.47,Cap,,0,0,0,,CITY WERE FOUND GUILTY
Dialogue: 0,0:05:04.47,0:05:05.55,Cap,,0,0,0,,AND LIVERPOOL WERE HANDED
Dialogue: 0,0:05:05.55,0:05:06.58,Cap,,0,0,0,,A TITLE.
Dialogue: 0,0:05:06.80,0:05:07.68,Cap,,0,0,0,,I TOLD ALL THE
Dialogue: 0,0:05:07.68,0:05:08.52,Cap,,0,0,0,,PEOPLE WHO WANTED TO
Dialogue: 0,0:05:08.52,0:05:10.33,Cap,,0,0,0,,JUST BOOK A FLIGHT,
Dialogue: 0,0:05:10.82,0:05:11.81,Cap,,0,0,0,,I'D BUY THE BEER.
Dialogue: 0,0:05:12.76,0:05:14.16,Cap,,0,0,0,,SO WHATEVER WE HAVE
Dialogue: 0,0:05:14.16,0:05:14.80,Cap,,0,0,0,,TO CELEBRATE,
Dialogue: 0,0:05:14.80,0:05:15.28,Cap,,0,0,0,,WE WOULD DO IT
Dialogue: 0,0:05:15.28,0:05:16.32,Cap,,0,0,0,,SO GOOD WEATHER STUFF
Dialogue: 0,0:05:16.32,0:05:17.00,Cap,,0,0,0,,LIKE THIS.
Dialogue: 0,0:05:17.00,0:05:17.56,Cap,,0,0,0,,WE WOULD HAVE OUR
Dialogue: 0,0:05:17.56,0:05:18.36,Cap,,0,0,0,,OWN PARADE IN MY
Dialogue: 0,0:05:18.36,0:05:18.89,Cap,,0,0,0,,GARDEN.
Dialogue: 0,0:05:19.34,0:05:20.29,Cap,,0,0,0,,ON THE TWENTY-NINTH OF
Dialogue: 0,0:05:20.29,0:05:20.96,Cap,,0,0,0,,SEPTEMBER,
Dialogue: 0,0:05:20.96,0:05:22.14,Cap,,0,0,0,,TWENTY TWENTY-SIX,
Dialogue: 0,0:05:22.14,0:05:23.09,Cap,,0,0,0,,THE COMMISSION DELIVERED
Dialogue: 0,0:05:23.09,0:05:23.97,Cap,,0,0,0,,ITS VERDICT.
Dialogue: 0,0:05:23.97,0:05:25.32,Cap,,0,0,0,,GUILTY ON ALMOST ALL
Dialogue: 0,0:05:25.32,0:05:26.39,Cap,,0,0,0,,OF THE CHARGES.
Dialogue: 0,0:05:26.39,0:05:28.07,Cap,,0,0,0,,SHAM CONTRACTS WITH COMMERCIAL
Dialogue: 0,0:05:28.07,0:05:28.93,Cap,,0,0,0,,PARTNERS.
Dialogue: 0,0:05:28.93,0:05:29.91,Cap,,0,0,0,,MORE THAN NINE HUNDRED
Dialogue: 0,0:05:29.91,0:05:31.07,Cap,,0,0,0,,MILLION POUNDS.
Dialogue: 0,0:05:31.07,0:05:31.88,Cap,,0,0,0,,AND THREE OF THE
Dialogue: 0,0:05:31.88,0:05:33.13,Cap,,0,0,0,,FOUR CHARGES OF FAILING
Dialogue: 0,0:05:33.13,0:05:34.31,Cap,,0,0,0,,TO COOPERATE,
Dialogue: 0,0:05:34.34,0:05:35.23,Cap,,0,0,0,,UPHELD.
Dialogue: 0,0:05:35.68,0:05:36.44,Cap,,0,0,0,,BY THEN,
Dialogue: 0,0:05:36.44,0:05:37.23,Cap,,0,0,0,,KLOPP WAS THE HEAD
Dialogue: 0,0:05:37.23,0:05:38.38,Cap,,0,0,0,,COACH OF GERMANY.
Dialogue: 0,0:05:38.38,0:05:39.15,Cap,,0,0,0,,HE WAS ASKED ABOUT
Dialogue: 0,0:05:39.15,0:05:39.68,Cap,,0,0,0,,IT AT A PRESS
Dialogue: 0,0:05:39.68,0:05:40.72,Cap,,0,0,0,,CONFERENCE.
Dialogue: 0,0:06:04.42,0:06:05.55,Cap,,0,0,0,,AND TO BE FAIR,
Dialogue: 0,0:06:05.55,0:06:06.81,Cap,,0,0,0,,THE FINANCIAL BREACHES THE
Dialogue: 0,0:06:06.81,0:06:08.25,Cap,,0,0,0,,COMMISSION FOUND RAN FROM
Dialogue: 0,0:06:08.25,0:06:09.36,Cap,,0,0,0,,TWO THOUSAND AND NINE
Dialogue: 0,0:06:09.36,0:06:10.65,Cap,,0,0,0,,TO TWENTY EIGHTEEN,
Dialogue: 0,0:06:10.65,0:06:11.93,Cap,,0,0,0,,BEFORE KLOPP'S TWO TITLE
Dialogue: 0,0:06:11.93,0:06:13.24,Cap,,0,0,0,,RACES WITH CITY.
Dialogue: 0,0:06:13.37,0:06:14.95,Cap,,0,0,0,,CITY DENY ALL WRONGDOING,
Dialogue: 0,0:06:14.95,0:06:15.88,Cap,,0,0,0,,AND THEY HAVE ALREADY
Dialogue: 0,0:06:15.88,0:06:17.21,Cap,,0,0,0,,LODGED AN APPEAL.
Dialogue: 0,0:06:17.34,0:06:18.68,Cap,,0,0,0,,THE PUNISHMENT HAS NOT
Dialogue: 0,0:06:18.68,0:06:19.74,Cap,,0,0,0,,BEEN DECIDED.
Dialogue: 0,0:06:19.74,0:06:20.69,Cap,,0,0,0,,KLOPP DOES NOT WANT
Dialogue: 0,0:06:20.69,0:06:21.35,Cap,,0,0,0,,A TROPHY FROM A
Dialogue: 0,0:06:21.35,0:06:21.95,Cap,,0,0,0,,COURTROOM.
Dialogue: 0,0:06:21.95,0:06:22.82,Cap,,0,0,0,,HE NEVER ASKED FOR
Dialogue: 0,0:06:22.82,0:06:23.57,Cap,,0,0,0,,ONE.
Dialogue: 0,0:06:23.67,0:06:24.90,Cap,,0,0,0,,WHAT HE DID,
Dialogue: 0,0:06:24.97,0:06:26.04,Cap,,0,0,0,,FOR YEARS,
Dialogue: 0,0:06:26.04,0:06:27.65,Cap,,0,0,0,,WAS DESCRIBE THE PROBLEM.
Dialogue: 0,0:06:27.73,0:06:28.58,Cap,,0,0,0,,OUT LOUD.
Dialogue: 0,0:06:28.58,0:06:30.04,Cap,,0,0,0,,TO ANYONE WHO ASKED.
Dialogue: 0,0:06:30.23,0:06:31.61,Cap,,0,0,0,,CITY'S MONEY WAS DIFFERENT.
Dialogue: 0,0:06:31.61,0:06:32.54,Cap,,0,0,0,,THE COMPETITION WAS NOT
Dialogue: 0,0:06:32.54,0:06:33.40,Cap,,0,0,0,,THE SAME.
Dialogue: 0,0:06:33.47,0:06:34.39,Cap,,0,0,0,,SOMEONE SHOULD CHECK WHERE
Dialogue: 0,0:06:34.39,0:06:35.60,Cap,,0,0,0,,THE MONEY COMES FROM.
Dialogue: 0,0:06:35.60,0:06:36.31,Cap,,0,0,0,,HE WAS TOLD IT
Dialogue: 0,0:06:36.31,0:06:37.54,Cap,,0,0,0,,WAS AN EXCUSE.
Dialogue: 0,0:06:37.54,0:06:38.79,Cap,,0,0,0,,THAT HE WAS BITTER.
Dialogue: 0,0:06:38.79,0:06:39.72,Cap,,0,0,0,,THAT LIVERPOOL SHOULD JUST
Dialogue: 0,0:06:39.72,0:06:40.72,Cap,,0,0,0,,SPEND MORE.
Dialogue: 0,0:06:40.86,0:06:41.17,Cap,,0,0,0,,NOW,
Dialogue: 0,0:06:41.17,0:06:42.12,Cap,,0,0,0,,A COMMISSION HAS LOOKED
Dialogue: 0,0:06:42.12,0:06:43.14,Cap,,0,0,0,,AT WHERE CITY'S MONEY
Dialogue: 0,0:06:43.14,0:06:44.22,Cap,,0,0,0,,CAME FROM.
Dialogue: 0,0:06:44.44,0:06:45.70,Cap,,0,0,0,,WE CANNOT ACT LIKE
Dialogue: 0,0:06:45.70,0:06:46.21,Cap,,0,0,0,,THEM.
Dialogue: 0,0:06:47.14,0:06:48.05,Cap,,0,0,0,,IT'S NOT POSSIBLE,
Dialogue: 0,0:06:48.20,0:06:49.51,Cap,,0,0,0,,NOT POSSIBLE.
Dialogue: 0,0:06:49.96,0:06:51.69,Cap,,0,0,0,,JÜRGEN KLOPP WAS RIGHT.
