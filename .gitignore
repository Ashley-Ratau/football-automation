# Secrets — put API keys in the cloud environment's settings, never in git
.env
.env.*
*.key
credentials*.json
client_secret*.json
token*.json

# Render caches and outputs (regenerated by build.py)
_tmp/
**/final video/
*.part
*.ytdl

# Downloaded source footage (re-downloaded by yt-dlp from the IDs in script.json)
**/assets/clips/*.mp4
**/assets/clips/*.webm
**/assets/clips/*.m4a
**/assets/clips/*.exe
**/assets/broll/*.mp4

# Python
__pycache__/
*.pyc
.venv/
